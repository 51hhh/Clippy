      },
      {
        "id": 2,
        "x": 0,
        "y": -1080,
        "width": 1920,
        "height": 1080,
        "scale": 1.0,
        "crop": { "x": 0, "y": 0, "width": 1920, "height": 1080 }
      }
    ]
  }
