{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clippy",
  "version": "0.1.6",
  "identifier": "com.clippy.app",
  "build": {
    "beforeDevCommand": "cd ../src && npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../src && npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Clippy",
        "width": 380,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QjMwRDEzRjJDN0UwMwpSV1FEZml3LzBUQmJCM1dtSXExNGk1aWNrRDllYTZYd252RjFZakcwb2hRYnBQVGRxdHhLOVZpbwo=",
      "endpoints": [
        "https://github.com/51hhh/Clippy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "desktopTemplate": "com.clippy.app.desktop",
        "postInstallScript": "scripts/postinst.sh",
        "postRemoveScript": "scripts/postrm.sh"
      }
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
