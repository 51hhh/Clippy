{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clippy",
  "version": "0.1.20",
  "identifier": "com.clippy.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../src"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../src"
    },
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "enableGTKAppId": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Clippy",
        "width": 380,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob: capture-frame: http://capture-frame.localhost pin-frame: http://pin-frame.localhost; media-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QjMwRDEzRjJDN0UwMwpSV1FEZml3LzBUQmJCM1dtSXExNGk1aWNrRDllYTZYd252RjFZakcwb2hRYnBQVGRxdHhLOVZpbwo=",
      "endpoints": [
        "https://github.com/51hhh/Clippy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
