{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clippy.local/schemas/ocr-quality-predictions-v1.json",
  "title": "Clippy OCR quality predictions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine", "cases"],
  "properties": {
    "schema": { "const": "clippy-ocr-quality-predictions-v1" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lineGeometry", "structuredFormula"],
          "allOf": [
            {
              "if": {
                "properties": { "structuredFormula": { "const": true } }
              },
              "then": {
                "properties": { "lineGeometry": { "const": true } }
              }
            }
          ],
          "properties": {
            "lineGeometry": { "type": "boolean" },
            "structuredFormula": { "type": "boolean" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },
    "quad": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/point" }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "value"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "quad"],
      "properties": {
        "text": { "type": "string" },
        "quad": { "$ref": "#/$defs/quad" },
        "kind": { "enum": ["text", "formula"] },
        "formula": { "$ref": "#/$defs/formula" },
        "paragraphId": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "lines"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "lines": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/line" }
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "peakMemoryBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
