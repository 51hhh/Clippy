{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clippy.local/schemas/ocr-table-corpus-v1.json",
  "title": "Clippy OCR table corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "clippy-ocr-table-corpus-v1" },
    "cases": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false
    },
    "quad": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/point" }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "quad", "columnIndex"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "quad": { "$ref": "#/$defs/quad" },
        "columnIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cells"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/cell" }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/row" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "license", "imagePath", "sha256", "width", "height"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "imagePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tags", "source", "tables"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "$ref": "#/$defs/source" },
        "tables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/table" }
        }
      }
    }
  }
}
