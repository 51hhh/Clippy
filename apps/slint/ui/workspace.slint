import { LineEdit, ListView } from "std-widgets.slint";
import { ClippyIcon, ClippyTheme, LibraryHeader, SurfaceButton } from "theme.slint";
import { WorkspaceGrid, WorkspaceRow } from "workspace-grid.slint";
export { WorkspaceRow }

export struct WorkspaceGroupRow { key: string, label: string, count: int }

export component WorkspaceWindow inherits Window {
    in property <[WorkspaceRow]> pins;
    in property <[WorkspaceGroupRow]> groups;
    in property <[string]> destinations;
    in property <string> group-filter;
    in property <string> group-name;
    in property <string> status;
    callback open-pin(string);
    callback delete-pin(string);
    callback select-group(string);
    callback move-to-group(string, string);
    callback create-group(string);
    callback rename-group(string, string);
    callback delete-group(string);
    callback viewport(int, int);
    callback close-workspace();

    private property <bool> confirm-group;

    title: @tr("Clippy Pinned Workspace");
    preferred-width: 820px;
    preferred-height: 640px;
    min-width: 460px;
    min-height: 360px;
    no-frame: true;
    resize-border-width: ClippyTheme.window-resize-border;
    background: ClippyTheme.background;
    init => { ClippyTheme.sync-native-palette(); }

    public pure function titlebar-contains(x: length, y: length) -> bool {
        return x >= root.resize-border-width && x < root.width - 61px
            && y >= root.resize-border-width && y < titlebar.height;
    }

    changed group-filter => { root.confirm-group = false; }

    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        titlebar := LibraryHeader {
            title: @tr("Pin Workspaces");
            subtitle: @tr("Return to saved pins and organize them without changing clipboard history.");
            dismiss => { root.close-workspace(); }
        }
        HorizontalLayout {
            Rectangle {
                width: root.width >= 560px ? 210px : 160px;
                background: ClippyTheme.elevated;
                VerticalLayout {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    alignment: start;
                    padding: 12px; padding-top: 14px; spacing: 10px;
                    ListView {
                        height: min(root.groups.length * 41px, parent.height * 0.42);
                        for group in root.groups: Rectangle {
                            height: 41px;
                            SurfaceButton {
                                label: group.label + ", " + @tr("{0} pins", group.count);
                                caption: "";
                                y: 0px; width: parent.width; height: 38px;
                                selected: group.key == root.group-filter;
                                background: self.selected ? ClippyTheme.accent-soft : self.hovered ? ClippyTheme.hover : transparent;
                                clicked => { root.select-group(group.key); }
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 5px;
                                    Text {
                                        text: group.label; font-size: 13px; overflow: elide;
                                        color: group.key == root.group-filter ? ClippyTheme.accent : ClippyTheme.foreground;
                                        font-weight: group.key == root.group-filter ? 650 : 500;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: "" + group.count; font-size: 11px;
                                        color: ClippyTheme.subtle; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px; height: 36px;
                        name := LineEdit {
                            placeholder-text: @tr("New group"); accessible-label: @tr("New group name");
                            accepted => { if self.text != "" { root.create-group(self.text); self.text = ""; } }
                        }
                        SurfaceButton {
                            label: @tr("Create group"); caption: "+";
                            width: 36px; enabled: name.text != "";
                            border-width: 1px; border-color: ClippyTheme.border;
                            clicked => { root.create-group(name.text); name.text = ""; }
                        }
                    }
                    if root.group-name != "": VerticalLayout {
                        spacing: 7px;
                        Rectangle { height: 1px; background: ClippyTheme.border; }
                        Text { text: @tr("Manage group"); color: ClippyTheme.muted; font-size: 11px; }
                        rename := LineEdit {
                            text: root.group-name;
                            accessible-label: @tr("Group name");
                            accepted => { if self.text != "" { root.rename-group(root.group-filter, self.text); } }
                        }
                        if !root.confirm-group: HorizontalLayout {
                            spacing: 5px;
                            SurfaceButton {
                                label: @tr("Rename"); enabled: rename.text != "" && rename.text != root.group-name;
                                border-width: 1px; border-color: ClippyTheme.border;
                                clicked => { root.rename-group(root.group-filter, rename.text); }
                            }
                            SurfaceButton {
                                label: @tr("Delete"); danger: true;
                                border-width: 1px; border-color: ClippyTheme.border;
                                clicked => { root.confirm-group = true; }
                            }
                        }
                        if root.confirm-group: VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Delete this group? Its pins will be ungrouped."); color: ClippyTheme.danger; wrap: word-wrap; font-size: 11px; }
                            HorizontalLayout {
                                spacing: 4px;
                                SurfaceButton { label: @tr("Cancel"); clicked => { root.confirm-group = false; } }
                                SurfaceButton { label: @tr("Delete"); danger: true; clicked => { root.delete-group(root.group-filter); root.confirm-group = false; } }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: ClippyTheme.border; }
            VerticalLayout {
                padding: 16px; padding-left: 18px; padding-right: 18px; padding-bottom: 24px;
                spacing: 8px; horizontal-stretch: 1;
                if root.status != "": Text { text: root.status; color: ClippyTheme.danger; wrap: word-wrap; }
                WorkspaceGrid {
                    vertical-stretch: 1;
                    rows: root.pins;
                    destinations: root.destinations;
                    filter: root.group-filter;
                    viewport(first, end) => { root.viewport(first, end); }
                    open(id) => { root.open-pin(id); }
                    remove(id) => { root.delete-pin(id); }
                    move-to(id, index) => { root.move-to-group(id, root.groups[index + 1].key); }
                }
            }
        }
    }
}
