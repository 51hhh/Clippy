import { ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { ClippyTheme, SurfaceButton, WindowHeader } from "theme.slint";

export struct WorkspaceGroupRow { key: string, label: string, count: int }
export struct WorkspaceRow { id: string, label: string, group: string, group-key: string }

export component WorkspaceWindow inherits Window {
    in property <[WorkspaceRow]> pins;
    in property <[WorkspaceGroupRow]> groups;
    in property <[string]> destinations;
    in-out property <string> selection;
    in property <string> group-filter;
    in property <string> status;
    callback open-pin(string);
    callback delete-pin(string);
    callback select-group(string);
    callback move-to-group(string, string);
    callback create-group(string);
    callback close-workspace();

    private property <string> confirm-remove;

    title: "Clippy Pinned Workspace";
    preferred-width: 820px;
    preferred-height: 640px;
    min-width: 460px;
    min-height: 360px;
    no-frame: true;
    resize-border-width: 6px;
    background: ClippyTheme.background;
    init => { ClippyTheme.sync-native-palette(); }

    public pure function titlebar-contains(x: length, y: length) -> bool {
        return ClippyTheme.titlebar-contains(x, y, root.width, root.resize-border-width);
    }

    changed group-filter => {
        list.content-y = 0px;
        root.confirm-remove = "";
    }
    changed selection => { root.confirm-remove = ""; }

    VerticalLayout {
        WindowHeader {
            title: "Pinned Workspace";
            maximized: root.maximized;
            minimize => { root.minimized = true; }
            maximize => { root.maximized = !root.maximized; }
            dismiss => { root.close-workspace(); }
        }
        HorizontalLayout {
            Rectangle {
                width: 190px;
                background: ClippyTheme.elevated;
                VerticalLayout {
                    padding: 12px;
                    spacing: 7px;
                    Text { text: "Groups"; color: ClippyTheme.muted; font-size: 12px; font-weight: 600; }
                    ListView {
                        for group in root.groups: SurfaceButton {
                            label: group.label + ", " + group.count + " pins";
                            caption: "";
                            selected: group.key == root.group-filter;
                            pill: true;
                            height: 34px;
                            clicked => { root.select-group(group.key); }
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 9px;
                                spacing: 4px;
                                Text {
                                    text: group.label; color: ClippyTheme.foreground; font-size: 13px;
                                    overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
                                }
                                Text { text: "" + group.count; color: ClippyTheme.muted; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                    name := LineEdit {
                        placeholder-text: "New group";
                        accessible-label: "New group name";
                        accepted => { if self.text != "" { root.create-group(self.text); self.text = ""; } }
                    }
                    SurfaceButton {
                        label: "Create group";
                        enabled: name.text != "";
                        clicked => { root.create-group(name.text); name.text = ""; }
                    }
                }
            }
            Rectangle { width: 1px; background: ClippyTheme.border; }
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                horizontal-stretch: 1;
                Rectangle {
                    vertical-stretch: 1;
                    list := ListView {
                        width: parent.width;
                        height: parent.height;
                        for pin in root.pins: Rectangle {
                            height: 58px;
                            border-radius: 7px;
                            background: root.selection == pin.id ? ClippyTheme.accent-soft
                                : hit.has-hover ? ClippyTheme.hover : ClippyTheme.surface;
                            accessible-role: list-item;
                            accessible-label: pin.label;
                            accessible-action-default => { root.selection = pin.id; root.open-pin(pin.id); }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 2px;
                                Text { text: pin.label; color: ClippyTheme.foreground; font-size: 14px; overflow: elide; }
                                Text { text: pin.group; color: ClippyTheme.muted; font-size: 11px; overflow: elide; }
                            }
                            hit := TouchArea {
                                clicked => { root.selection = pin.id; }
                                double-clicked => { root.open-pin(pin.id); }
                            }
                        }
                    }
                    if root.pins.length == 0: Text {
                        text: root.group-filter == "" ? "No saved pins" : "No pins in this group";
                        color: ClippyTheme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    destination := ComboBox { model: root.destinations; current-index: 0; enabled: root.selection != ""; }
                    SurfaceButton {
                        label: "Move to group";
                        enabled: root.selection != "" && destination.current-index >= 0 && destination.current-index + 1 < root.groups.length;
                        clicked => { root.move-to-group(root.selection, root.groups[destination.current-index + 1].key); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    SurfaceButton { label: "Open pin"; width: 110px; selected: true; enabled: root.selection != ""; clicked => { root.open-pin(root.selection); } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.confirm-remove != "": SurfaceButton { label: "Cancel"; clicked => { root.confirm-remove = ""; } }
                    SurfaceButton {
                        label: root.confirm-remove == "" ? "Remove" : "Confirm removal";
                        enabled: root.selection != "";
                        danger: true;
                        clicked => {
                            if root.confirm-remove == root.selection {
                                root.delete-pin(root.selection);
                                root.confirm-remove = "";
                            } else { root.confirm-remove = root.selection; }
                        }
                    }
                }
                Text { text: root.status; color: ClippyTheme.muted; min-height: 18px; wrap: word-wrap; }
            }
        }
    }
}
