import { ClipRow, HistoryPane } from "history.slint";
import { ClipPreview, HistoryPreviewPane } from "history-preview.slint";
import { GeneralSettings, SettingsPane, ShortcutField, TranslationSettings } from "settings.slint";
import { ClippyTheme, WindowHeader } from "theme.slint";
export { GeneralSettings, TranslationSettings, ShortcutField, ClippyTheme, ClipRow, ClipPreview }
export { EditorWindow } from "editor.slint";
export { PinnedWindow } from "pins.slint";
export { WorkspaceWindow, WorkspaceRow, WorkspaceGroupRow } from "workspace.slint";
export { LongshotWindow } from "longshot.slint";
export { ImageTextWindow, TextBox, TextParagraph } from "vision.slint";
export { RecordingLibrary, RecordingRow } from "recording.slint";
export { ToolsWindow, TranslationRow } from "tools.slint";
export { LauncherWindow, LauncherAction, LauncherRow } from "launcher.slint";

export { CaptureWindow, CaptureAction } from "capture.slint";

export component ClippyTray inherits SystemTrayIcon {
    in property <string> product-name;
    callback open-panel();
    callback screenshot();
    callback delayed-screenshot();
    callback save-screens();
    callback open-settings();
    callback open-actions();
    callback open-workspace();
    callback recordings();
    callback recording-pause();
    callback recording-stop();
    callback quit();

    tooltip: root.product-name;
    icon: @image-url("../../legacy-tauri/native/icons/32x32.png");
    clicked => { root.open-panel(); }

    Menu {
        MenuItem { title: "Open Clipboard"; activated => { root.open-panel(); } }
        MenuItem { title: "Screenshot"; activated => { root.screenshot(); } }
        MenuItem { title: "Screenshot in 3 seconds"; activated => { root.delayed-screenshot(); } }
        MenuItem { title: "Save screens to PNG"; activated => { root.save-screens(); } }
        MenuItem { title: "Actions"; activated => { root.open-actions(); } }
        MenuItem { title: "Pinned Workspace"; activated => { root.open-workspace(); } }
        MenuItem { title: "Recordings"; activated => { root.recordings(); } }
        MenuItem { title: "Pause / Resume recording"; activated => { root.recording-pause(); } }
        MenuItem { title: "Stop recording"; activated => { root.recording-stop(); } }
        MenuItem { title: "Settings"; activated => { root.open-settings(); } }
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}

export component AppWindow inherits Window {
    in property <string> product-name;
    in property <string> build-label;
    in property <string> history-status: "Loading history…";
    in property <string> action-status;
    in property <string> shortcut-status;
    in property <GeneralSettings> general-settings;
    in-out property <ShortcutField> recording-shortcut;
    in-out property <string> panel-shortcut-draft;
    in-out property <string> capture-shortcut-draft;
    in property <TranslationSettings> translation-settings;
    in property <int> provider-index;
    in property <bool> autostart;
    in property <bool> autostart-available;
    in property <bool> tmux-available;
    in property <string> data-status;
    in property <[ClipRow]> clips;
    in-out property <string> selected-id;
    in-out property <int> selected-index: -1;
    in property <int> all-count;
    in property <int> favorite-count;
    in-out property <string> query;
    in-out property <bool> favorites-only;
    in-out property <int> history-limit: 50;
    in property <bool> can-load-more;
    in property <bool> loading-history: true;
    in property <bool> show-settings;
    in property <bool> auto-paste;
    in property <bool> busy;
    in property <bool> preview-open;
    in property <ClipPreview> preview;
    in property <int> history-focus-request;
    out property <length> panel-width: root.show-settings ? 720px : root.preview-open ? 780px : 380px;
    out property <bool> selected-sensitive: root.selected-index >= 0
        && root.selected-index < root.clips.length && root.clips[root.selected-index].sensitive;
    callback reload-history();
    callback close-panel();
    callback copy-item(string, bool);
    callback modify-item(string, bool);
    callback set-auto-paste(bool);
    callback authorize-paste();
    callback forget-paste();
    callback set-autostart(bool);
    callback apply-general(GeneralSettings);
    callback select-provider(int);
    callback apply-translation(int, TranslationSettings);
    callback store-credentials(int, string, string);
    callback delete-credentials(int);
    callback data-action(int, string);
    callback edit-history-image(string);
    callback preview-item(string);
    callback show-preview(bool);
    callback preview-selection-changed();
    callback open-launcher();

    changed selected-id => { root.preview-selection-changed(); }
    changed selected-sensitive => { root.preview-selection-changed(); }
    changed general-settings => {
        root.panel-shortcut-draft = root.general-settings.panel-shortcut;
        root.capture-shortcut-draft = root.general-settings.capture-shortcut;
    }

    title: root.show-settings ? "Clippy Settings" : root.product-name;
    preferred-width: root.panel-width;
    preferred-height: root.show-settings ? 560px : 500px;
    min-width: root.show-settings ? 480px : root.preview-open ? 540px : 340px;
    min-height: 400px;
    no-frame: true;
    resize-border-width: root.show-settings ? 6px : 0px;
    always-on-top: !root.show-settings;
    background: ClippyTheme.background;
    init => { ClippyTheme.sync-native-palette(); }

    public pure function titlebar-contains(x: length, y: length) -> bool {
        return ClippyTheme.titlebar-contains(x, y, root.width, root.resize-border-width);
    }

    VerticalLayout {
        if root.show-settings: WindowHeader {
            title: "Settings";
            maximized: root.maximized;
            minimize => { root.minimized = true; }
            maximize => { root.maximized = !root.maximized; }
            dismiss => { root.close-panel(); }
        }
        if root.shortcut-status != "": Text {
            text: root.shortcut-status;
            color: ClippyTheme.danger;
            wrap: word-wrap;
            font-size: 12px;
        }
        if !root.show-settings: FocusScope {
            vertical-stretch: 1;
            focus-on-click: false;
            capture-key-pressed(event) => {
                if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt
                    && !event.modifiers.shift && event.text == "k" {
                    root.open-launcher();
                    return accept;
                }
                reject
            }
            HorizontalLayout {
                HistoryPane {
                    min-width: 300px;
                    preferred-width: 380px;
                    horizontal-stretch: root.preview-open ? 0 : 1;
                    clips: root.clips;
                    status: root.history-status;
                    all-count: root.all-count;
                    favorite-count: root.favorite-count;
                    busy: root.busy;
                    loading: root.loading-history;
                    auto-paste: root.auto-paste;
                    can-load-more: root.can-load-more && root.history-limit < 200;
                    query <=> root.query;
                    favorites-only <=> root.favorites-only;
                    selected-id <=> root.selected-id;
                    selected-index <=> root.selected-index;
                    preview-open: root.preview-open;
                    focus-request: root.history-focus-request;
                    refresh => { root.history-limit = 50; root.reload-history(); }
                    load-more => { root.history-limit += 50; root.reload-history(); }
                    close-panel => { root.close-panel(); }
                    copy-item(id, paste) => { root.copy-item(id, paste); }
                    modify-item(id, favorite) => { root.modify-item(id, favorite); }
                    show-preview(open) => { root.show-preview(open); }
                }
                if root.preview-open: HistoryPreviewPane {
                    preview: root.preview;
                    selected-id: root.selected-id;
                    selected-sensitive: root.selected-sensitive;
                    loading: root.loading-history;
                    busy: root.busy;
                    dismiss => { root.show-preview(false); }
                    copy => { root.copy-item(root.preview.clip-id, false); }
                    open-image => { root.edit-history-image(root.preview.clip-id); }
                    open-tools => { root.preview-item(root.preview.clip-id); }
                }
            }
        }

        if root.show-settings: SettingsPane {
            vertical-stretch: 1;
            general: root.general-settings;
            recording-shortcut <=> root.recording-shortcut;
            panel-shortcut <=> root.panel-shortcut-draft;
            capture-shortcut <=> root.capture-shortcut-draft;
            translation: root.translation-settings;
            provider-index: root.provider-index;
            auto-paste: root.auto-paste;
            busy: root.busy;
            build-label: root.build-label;
            autostart: root.autostart;
            autostart-available: root.autostart-available;
            tmux-available: root.tmux-available;
            data-status: root.data-status;
            paste-setting(value) => { root.set-auto-paste(value); }
            authorize-paste => { root.authorize-paste(); }
            forget-paste => { root.forget-paste(); }
            set-autostart(value) => { root.set-autostart(value); }
            apply-general(value) => { root.apply-general(value); }
            select-provider(index) => { root.select-provider(index); }
            apply-translation(index, value) => { root.apply-translation(index, value); }
            store-credentials(index, key, secret) => { root.store-credentials(index, key, secret); }
            delete-credentials(index) => { root.delete-credentials(index); }
            data-action(action, path) => { root.data-action(action, path); }
        }

        if root.action-status != "": Text {
            text: root.action-status;
            color: ClippyTheme.muted;
            font-size: 12px;
            min-height: 21px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
