import { SurfaceButton } from "theme.slint";

export enum LongshotDirection { down, up, left, right }

component CaptureStatistic inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    background: #282a2f;
    border-radius: 6px;
    VerticalLayout {
        padding: 9px; spacing: 3px;
        Text { text: root.caption; font-size: 11px; color: #d1d5db; }
        Text { text: root.value; font-size: 16px; color: #f3f4f6; }
    }
}

component LongshotButton inherits SurfaceButton {
    caption: "";
    height: 32px;
    border-radius: 6px; border-width: 1px;
    border-color: self.enabled && self.hovered ? #5ca5ff : #424349;
    background: self.enabled && self.hovered ? #263c56 : #2b2d33;
    Text {
        text: root.label; font-size: 13px;
        color: root.enabled ? #f3f4f6 : #9296a0;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component LongshotWindow inherits Window {
    in property <image> preview;
    in property <bool> busy: true;
    in property <bool> can-undo;
    in property <bool> auto-scroll-available;
    in property <int> frames;
    in property <int> capture-width;
    in property <int> capture-height;
    in property <string> status: "Opening the capture source…";
    callback append();
    callback undo();
    callback finish();
    callback copy();
    callback save();
    callback pin();
    callback cancel();
    callback auto-scroll(LongshotDirection);

    title: "Clippy Scrolling Capture";
    no-frame: true;
    resize-border-width: 6px;
    background: #17191f;
    preferred-width: 400px;
    preferred-height: 560px;
    min-width: 340px;
    min-height: 390px;
    init => { keys.focus(); }

    public pure function titlebar-contains(x: length, y: length) -> bool {
        return x >= root.resize-border-width && x < root.width - root.resize-border-width
            && y >= root.resize-border-width && y < 53px;
    }

    keys := FocusScope {
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 20px; spacing: 14px;
            Text { text: "Scrolling Capture"; color: #f3f4f6; font-size: 16px; font-weight: 650; }
            Text {
                text: root.status;
                color: #d1d5db; font-size: 13px; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                CaptureStatistic { caption: "Frames"; value: "" + root.frames; }
                CaptureStatistic { caption: "Width"; value: "" + root.capture-width + " px"; }
                CaptureStatistic { caption: "Height"; value: "" + root.capture-height + " px"; }
            }
            Rectangle {
                vertical-stretch: 1;
                Rectangle {
                    width: min(parent.width, 320px); height: min(parent.height, 300px);
                    background: #282a2f; border-radius: 6px; clip: true;
                    Image { width: parent.width; height: parent.height; source: root.preview; image-fit: contain; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LongshotButton { label: "Copy"; enabled: !root.busy; clicked => { root.copy(); } }
                LongshotButton { label: "Save PNG"; enabled: !root.busy; clicked => { root.save(); } }
                LongshotButton { label: "Pin"; enabled: !root.busy; clicked => { root.pin(); } }
            }
            if root.auto-scroll-available : HorizontalLayout {
                spacing: 8px;
                LongshotButton { label: "Auto down"; enabled: !root.busy; clicked => { root.auto-scroll(LongshotDirection.down); } }
                LongshotButton { label: "Auto up"; enabled: !root.busy; clicked => { root.auto-scroll(LongshotDirection.up); } }
                LongshotButton { label: "Auto left"; enabled: !root.busy; clicked => { root.auto-scroll(LongshotDirection.left); } }
                LongshotButton { label: "Auto right"; enabled: !root.busy; clicked => { root.auto-scroll(LongshotDirection.right); } }
            }
            HorizontalLayout {
                spacing: 8px;
                LongshotButton { label: "Add frame"; enabled: !root.busy; clicked => { root.append(); } }
                LongshotButton { label: "Undo"; enabled: !root.busy && root.can-undo; clicked => { root.undo(); } }
                LongshotButton { label: "Finish"; enabled: !root.busy; clicked => { root.finish(); } }
                LongshotButton { label: "Cancel"; clicked => { root.cancel(); } }
            }
        }
    }
}
