import { ComboBox, ListView, TextEdit } from "std-widgets.slint";
import { ClippyTheme, SurfaceButton } from "theme.slint";
import { ClippyWindow } from "window.slint";

export struct TranslationRow { title: string, source: string, result: string }

export component ToolsWindow inherits ClippyWindow {
    in-out property <string> source;
    in-out property <string> result;
    in property <string> note;
    in property <bool> busy;
    in property <bool> system-screenshot-available;
    in property <bool> system-screenshot-pending;
    in property <[TranslationRow]> history;
    callback run-action(int, string);
    callback copy-text(string);
    callback speak(string);
    callback reload-history();
    callback clear-history();
    callback use-image();
    callback screenshot();
    callback system-screenshot();
    callback dismiss();
    private property <bool> show-history;
    private property <bool> confirm-clear;
    private property <int> action-index;

    title: "Clippy Actions";
    heading: root.show-history ? "Translation history" : "Text tools";
    preferred-width: 800px;
    preferred-height: 520px;
    min-height: 380px;
    min-width: 520px;
    dismiss-window => { root.dismiss(); }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            if !root.show-history: SurfaceButton { label: "Screenshot"; clicked => { root.screenshot(); } }
            if !root.show-history && root.system-screenshot-available: SurfaceButton {
                label: "System Screenshot…";
                enabled: !root.busy && !root.system-screenshot-pending;
                clicked => { root.system-screenshot(); }
            }
            if !root.show-history: SurfaceButton {
                label: "Open latest image"; enabled: !root.busy; clicked => { root.use-image(); }
            }
            Rectangle { horizontal-stretch: 1; }
            SurfaceButton {
                label: root.show-history ? "Back to text tools" : "Translation history";
                enabled: !root.busy;
                clicked => {
                    root.show-history = !root.show-history;
                    root.confirm-clear = false;
                    if root.show-history { root.reload-history(); }
                }
            }
        }
        if root.show-history: ListView {
            for row in root.history: SurfaceButton {
                height: 61px;
                label: row.title + " " + row.source;
                caption: "";
                clicked => {
                    root.action-index = 0;
                    root.source = row.source;
                    root.result = row.result;
                    root.show-history = false;
                }
                VerticalLayout {
                    padding: 6px;
                    Text { text: row.title; color: ClippyTheme.accent; font-size: 12px; }
                    Text { text: row.source; color: ClippyTheme.muted; overflow: elide; }
                    Text { text: row.result; color: ClippyTheme.foreground; overflow: elide; }
                }
            }
        }
        if root.show-history: SurfaceButton {
            label: root.confirm-clear ? "Confirm clearing history" : "Clear translation history";
            clicked => {
                if root.confirm-clear {
                    root.clear-history();
                    root.confirm-clear = false;
                } else {
                    root.confirm-clear = true;
                }
            }
        }
        if !root.show-history: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                Text { text: "Source"; color: ClippyTheme.foreground; font-weight: 600; }
                TextEdit {
                    text <=> root.source;
                    accessible-label: "Source text";
                    read-only: root.busy;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    edited => { root.result = ""; }
                }
                SurfaceButton { label: "Copy source"; enabled: !root.busy && !root.source.is-empty; clicked => { root.copy-text(root.source); } }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                Text { text: root.action-index == 0 ? "Translation" : "Result"; color: ClippyTheme.foreground; font-weight: 600; }
                TextEdit {
                    text <=> root.result;
                    accessible-label: "Text result";
                    read-only: true;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 6px;
                    SurfaceButton { label: "Copy result"; enabled: !root.busy && !root.result.is-empty; clicked => { root.copy-text(root.result); } }
                    SurfaceButton { label: "Read aloud online"; enabled: !root.busy && !root.result.is-empty; clicked => { root.speak(root.result); } }
                }
            }
        }
        if !root.show-history: HorizontalLayout {
            spacing: 8px;
            ComboBox {
                model: ["Translate", "Markdown preview", "Format JSON", "Encode Base64", "Decode Base64",
                    "Encode URL component", "Decode URL component", "Encode hex", "Decode hex"];
                current-index <=> root.action-index;
                enabled: !root.busy;
                selected => { root.result = ""; }
            }
            SurfaceButton {
                label: root.action-index == 0 ? "Translate" : "Run";
                selected: true;
                enabled: !root.busy && !root.source.is-empty;
                clicked => { root.run-action(root.action-index, root.source); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.note; color: ClippyTheme.muted; overflow: elide; min-height: 18px; }
    }
}
