import { ListView } from "std-widgets.slint";
import { ClippyIcon, ClippyTheme, Keycap, SurfaceButton } from "theme.slint";

export enum LauncherAction {
    capture, system-capture, edit-image, recognize, scan, pin-image, save-image,
    text-tools, workspace, recordings, settings,
}

export struct LauncherRow { action: LauncherAction, label: string, detail: string }

export component LauncherWindow inherits Window {
    in property <[LauncherRow]> actions;
    in property <string> status;
    in property <string> source-title;
    in property <string> source-detail;
    in property <bool> busy;
    out property <string> query: input.text;
    callback search(string);
    callback launch(LauncherAction);
    callback dismiss();

    private property <int> selected: 0;

    title: @tr("Clippy Launcher");
    preferred-width: 640px;
    preferred-height: 520px;
    min-width: 420px;
    min-height: 360px;
    no-frame: true;
    resize-border-width: 6px;
    always-on-top: true;
    background: ClippyTheme.background;
    init => { ClippyTheme.sync-native-palette(); input.focus(); }

    public pure function titlebar-contains(x: length, y: length) -> bool {
        return x >= root.resize-border-width && x < root.width - 48px
            && y >= root.resize-border-width && y < 48px;
    }

    pure function action-drawing(action: LauncherAction) -> string {
        return action == LauncherAction.capture || action == LauncherAction.system-capture
            ? "M5 6h3l2-3h4l2 3h3a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V8a2 2 0 0 1 2 -2Z M16 13a4 4 0 1 1 -8 0a4 4 0 1 1 8 0"
            : action == LauncherAction.recognize ? "M4 9V4h5 M15 4h5v5 M20 15v5h-5 M9 20H4v-5 M8 9h8 M8 12h8 M8 15h5"
            : action == LauncherAction.pin-image ? "M9 4h6v3l-1 1v4l3 3v2H7v-2l3-3V8L9 7Z M12 17v5"
            : action == LauncherAction.save-image ? "M6 3h8l4 4v14H6Z M14 3v5h4 M12 11v6m-3 -3l3 3 3-3"
            : action == LauncherAction.scan ? "M3 3h6v6H3Z M15 3h6v6h-6Z M3 15h6v6H3Z M15 15h2v2h-2Z M21 15v6h-6 M18 21v-3h3"
            : action == LauncherAction.edit-image ? "M4 7V4h3 M17 4h3v3 M20 17v3h-3 M7 20H4v-3 M9 15l1-4 6-6 3 3-6 6Z"
            : action == LauncherAction.recordings ? "M4 6h12v12H4Z M16 10l4-3v10l-4-3Z"
            : action == LauncherAction.workspace ? "M3 6h7l2 2h9v11H3Z M3 10h18"
            : action == LauncherAction.settings ? "M5 3v18 M12 3v18 M19 3v18 M2 8h6 M9 15h6 M16 10h6"
            : "M4 4h16v16H4Z M8 9h8 M8 13h8 M8 17h4";
    }

    function activate() {
        if !root.busy && root.selected < root.actions.length {
            root.launch(root.actions[root.selected].action);
        }
    }

    FocusScope {
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.UpArrow {
                if root.actions.length > 0 {
                    root.selected = clamp(root.selected + (event.text == Key.DownArrow ? 1 : -1), 0, root.actions.length - 1);
                    list.ensure-row-visible(root.selected, ScrollBehavior.instant);
                }
                return accept;
            }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: 48px;
                background: ClippyTheme.elevated;
                Rectangle { y: parent.height - 1px; height: 1px; background: ClippyTheme.border; }
                HorizontalLayout {
                    padding-left: 16px; padding-right: 12px; spacing: 10px;
                    Text { text: "⌘"; color: ClippyTheme.highlight; font-size: 19px; vertical-alignment: center; }
                    Text { text: @tr("Actions"); color: ClippyTheme.foreground; font-size: 14px; font-weight: 650; vertical-alignment: center; }
                    Keycap { caption: "Ctrl K"; y: (parent.height - self.height) / 2; }
                    Rectangle { horizontal-stretch: 1; }
                    SurfaceButton {
                        label: @tr("Close actions"); caption: "×"; width: 30px; height: 30px;
                        y: (parent.height - self.height) / 2; clicked => { root.dismiss(); }
                    }
                }
            }
            VerticalLayout {
                padding-top: 14px;
                padding-left: 11px;
                padding-right: 11px;
                spacing: 9px;
                Rectangle {
                    height: 46px;
                    background: ClippyTheme.surface; border-radius: 10px; border-width: 1px; border-color: ClippyTheme.control-border;
                    ClippyIcon {
                        x: 13px; y: 14px; ink: ClippyTheme.muted;
                        drawing: "M17 10a7 7 0 1 1 -14 0a7 7 0 1 1 14 0 M15 15l6 6";
                    }
                    input := TextInput {
                        x: 39px; width: parent.width - 90px; height: parent.height;
                        single-line: true;
                        color: ClippyTheme.foreground;
                        font-size: 15px;
                        vertical-alignment: center;
                        accessible-label: @tr("Search actions");
                        edited => {
                            root.selected = 0;
                            list.content-y = 0px;
                            root.search(self.text);
                        }
                        accepted => { root.activate(); }
                    }
                    if input.text == "": Text {
                        x: input.x; height: parent.height; vertical-alignment: center;
                        text: @tr("Search actions…"); color: ClippyTheme.subtle; font-size: 15px;
                    }
                    Keycap { x: parent.width - 49px; y: 12px; width: 35px; caption: "Esc"; }
                }
                if root.source-title != "": Rectangle {
                    height: 54px; border-radius: 9px; border-width: 1px;
                    border-color: ClippyTheme.highlight.with-alpha(0.45);
                    background: ClippyTheme.highlight.with-alpha(0.08);
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 9px;
                        ClippyIcon {
                            y: (parent.height - self.height) / 2; ink: ClippyTheme.highlight;
                            drawing: root.action-drawing(LauncherAction.recognize);
                        }
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Text { text: root.source-title; color: ClippyTheme.foreground; font-size: 12px; font-weight: 650; }
                            Text { text: root.source-detail; color: ClippyTheme.muted; font-size: 11px; overflow: elide; }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    list := ListView {
                        width: parent.width;
                        height: parent.height;
                        for action[index] in root.actions: Rectangle {
                            height: 60px;
                            border-radius: 10px;
                            border-width: index == root.selected ? 1px : 0px;
                            border-color: ClippyTheme.highlight.with-alpha(0.55);
                            background: index == root.selected ? ClippyTheme.accent-soft
                                : hit.has-hover ? ClippyTheme.hover : transparent;
                            accessible-role: list-item;
                            accessible-label: action.label;
                            accessible-action-default => {
                                root.selected = index;
                                root.activate();
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                Rectangle {
                                    width: 36px; height: 36px; y: (parent.height - self.height) / 2;
                                    border-radius: 10px; background: ClippyTheme.accent-soft;
                                    ClippyIcon { x: 8px; y: 8px; width: 20px; height: 20px; ink: ClippyTheme.highlight; drawing: root.action-drawing(action.action); }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 4px; horizontal-stretch: 1;
                                    Text { text: action.label; color: ClippyTheme.foreground; font-size: 14px; font-weight: 650; overflow: elide; }
                                    Text { text: action.detail; color: ClippyTheme.muted; font-size: 12px; overflow: elide; }
                                }
                                Keycap { y: (parent.height - self.height) / 2; caption: "↵"; }
                            }
                            hit := TouchArea {
                                enabled: !root.busy;
                                mouse-cursor: pointer;
                                clicked => { root.selected = index; root.activate(); }
                            }
                        }
                    }
                    if root.actions.length == 0: Text {
                        text: @tr("No matching actions");
                        color: ClippyTheme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 37px;
                    Rectangle { height: 1px; background: ClippyTheme.border; }
                    if root.status == "": HorizontalLayout {
                        spacing: 6px; padding-left: 5px;
                        Keycap { caption: "↑"; y: 8px; }
                        Keycap { caption: "↓"; y: 8px; }
                        Text { text: @tr("Navigate"); color: ClippyTheme.muted; font-size: 11px; vertical-alignment: center; }
                        Keycap { caption: "↵"; y: 8px; }
                        Text { text: @tr("Open"); color: ClippyTheme.muted; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.status != "": Text {
                        x: 5px; width: parent.width - 10px; height: parent.height;
                        text: root.status; color: ClippyTheme.muted; font-size: 12px; vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
    }
}
