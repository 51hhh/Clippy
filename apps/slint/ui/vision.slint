import { Button, CheckBox, ListView, TextEdit, VerticalBox } from "std-widgets.slint";
import { ClippyTheme } from "theme.slint";
import { ClippyWindow } from "window.slint";

export struct TextBox {
    line: int,
    paragraph: int,
    outline: string,
    left: float,
    top: float,
    width: float,
    height: float,
    translated: string,
}

export struct TextParagraph {
    id: int,
    source: string,
    translated: string,
    left: float,
    top: float,
    width: float,
    height: float,
}

export struct CodeMatch { id: int, format: string, text: string }
export struct CodeMarker { id: int, x: float, y: float }

export component CodeMarkerLayer inherits Rectangle {
    in property <[CodeMarker]> markers;
    in property <int> selected-code: -1;
    callback select-code(int);

    for mark in root.markers: TouchArea {
        width: 24px;
        height: 24px;
        x: mark.x * root.width - self.width / 2;
        y: mark.y * root.height - self.height / 2;
        mouse-cursor: pointer;
        clicked => { root.select-code(mark.id); }
        Rectangle {
            width: 10px;
            height: 10px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            border-color: #252932;
            border-width: 1px;
            background: mark.id == root.selected-code ? #ffd158 : #29a7ef;
        }
    }
}

export component CodeMatchList inherits ListView {
    in property <[CodeMatch]> matches;
    in property <int> selected-code: -1;
    callback select-code(int);
    callback copy-code(int);

    for code in root.matches: Rectangle {
        height: max(52px, 29px + payload.height);
        clip: true;
        border-radius: 6px;
        background: root.selected-code == code.id ? ClippyTheme.accent-soft : ClippyTheme.surface;
        TouchArea { width: parent.width - 76px; clicked => { root.select-code(code.id); } }
        Text {
            x: 6px; y: 6px; text: code.format; color: ClippyTheme.foreground; font-weight: 600;
        }
        payload := Text {
            x: 6px; y: 23px; width: parent.width - 82px; height: self.preferred-height;
            text: code.text; wrap: word-wrap; overflow: elide; max-lines: 3; color: ClippyTheme.foreground;
        }
        Button {
            x: parent.width - self.width - 6px; y: 6px; width: 64px;
            text: @tr("Copy"); accessible-description: code.format;
            clicked => { root.copy-code(code.id); }
        }
    }
}

component TranslationOverlay inherits Rectangle {
    in property <string> translated;
    in property <bool> active;
    visible: root.active && root.translated != "" && root.width > 60px && root.height > 16px
        && translated-text.min-width <= root.width && translated-text.preferred-height <= root.height;
    clip: true;
    background: #fffffff2;
    translated-text := Text {
        width: parent.width;
        height: self.preferred-height;
        font-size: clamp(parent.height / 3, 12px, 20px);
        text: root.translated;
        color: #1c1d22;
        wrap: word-wrap;
    }
}

export component ImageTextWindow inherits ClippyWindow {
    in property <image> picture;
    in property <float> image-width: 1;
    in property <float> image-height: 1;
    in property <[TextBox]> boxes;
    in property <[TextParagraph]> paragraphs;
    in property <[CodeMatch]> code-matches;
    in property <[CodeMarker]> code-markers;
    in property <bool> scan-mode;
    in property <bool> scan-limited;
    in property <string> original;
    in property <string> current-text;
    in property <string> service;
    in property <string> status;
    in property <bool> busy;
    in-out property <int> selected-line: -1;
    in-out property <int> selected-paragraph: -1;
    in property <int> selected-code: -1;
    in-out property <bool> show-translation: true;
    callback select-line(int);
    callback select-paragraph(int);
    callback select-code(int);
    callback copy-code(int);
    callback copy-result();
    callback translate();
    callback dismiss();

    title: root.scan-mode ? @tr("Clippy Code Scan") : @tr("Clippy Image Text");
    heading: root.scan-mode ? @tr("Scan code") : @tr("Image Text");
    dismiss-window => { root.dismiss(); }
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 500px;
    min-height: 420px;

    HorizontalLayout {
        spacing: 10px;
        padding: 12px;
        vertical-stretch: 1;
        Rectangle {
            horizontal-stretch: 1;
            background: #252932;
            border-radius: 6px;
            depiction := Image {
                width: min(parent.width, parent.height * root.image-width / root.image-height);
                height: self.width * root.image-height / root.image-width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.picture;
                image-fit: fill;
                for box in root.boxes: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: root.image-width;
                    viewbox-height: root.image-height;
                    commands: box.outline;
                    stroke: box.line == root.selected-line ? #ffd158 : #29a7ef;
                    stroke-width: box.line == root.selected-line ? 2px : 1px;
                    fill: transparent;
                }
                for box in root.boxes: TouchArea {
                    x: box.left * depiction.width;
                    y: box.top * depiction.height;
                    width: box.width * depiction.width;
                    height: box.height * depiction.height;
                    clicked => { root.select-line(box.line); }
                }
                for result in root.paragraphs: TranslationOverlay {
                    x: result.left * depiction.width;
                    y: result.top * depiction.height;
                    width: result.width * depiction.width;
                    height: result.height * depiction.height;
                    active: root.show-translation && (root.selected-line < 0 || root.selected-paragraph != result.id);
                    translated: result.translated;
                }
                for box in root.boxes: TranslationOverlay {
                    x: box.left * depiction.width;
                    y: box.top * depiction.height;
                    width: box.width * depiction.width;
                    height: box.height * depiction.height;
                    active: root.show-translation && box.line == root.selected-line;
                    translated: box.translated;
                }
                if root.scan-mode: CodeMarkerLayer {
                    width: depiction.width; height: depiction.height;
                    markers: root.code-markers; selected-code: root.selected-code;
                    select-code(id) => { root.select-code(id); }
                }
            }
        }
        VerticalBox {
            width: 360px;
            padding: 0;
            spacing: 7px;
            if root.status != "": Text { text: root.status; wrap: word-wrap; color: ClippyTheme.muted; }
            if root.scan-limited: Text {
                text: @tr("Some codes were omitted."); wrap: word-wrap; color: ClippyTheme.muted;
            }
            if !root.scan-mode: ListView {
                for result in root.paragraphs: Rectangle {
                    height: max(53px, 12px + source-label.height + (translation-label.visible ? 4px + translation-label.height : 0px));
                    clip: true;
                    background: root.selected-paragraph == result.id ? ClippyTheme.accent-soft : ClippyTheme.surface;
                    TouchArea { clicked => { root.select-paragraph(result.id); } }
                    source-label := Text {
                        x: 6px; y: 6px; width: parent.width - 12px; height: self.preferred-height;
                        text: result.source; wrap: word-wrap; overflow: elide; max-lines: 3; color: ClippyTheme.foreground;
                    }
                    translation-label := Text {
                        x: 6px; y: source-label.y + source-label.height + 4px;
                        width: parent.width - 12px; height: self.preferred-height;
                        visible: result.translated != "";
                        text: result.translated; wrap: word-wrap; overflow: elide; max-lines: 3; color: ClippyTheme.accent;
                    }
                }
            }
            if root.scan-mode: CodeMatchList {
                matches: root.code-matches; selected-code: root.selected-code;
                select-code(id) => { root.select-code(id); }
                copy-code(id) => { root.copy-code(id); }
            }
            TextEdit {
                text: root.current-text == "" ? root.original : root.current-text;
                read-only: true;
                wrap: word-wrap;
                height: 110px;
            }
            if !root.scan-mode: CheckBox { text: @tr("Show translation on image"); checked <=> root.show-translation; }
            HorizontalLayout {
                spacing: 7px;
                Button {
                    text: root.scan-mode ? @tr("Copy all") : @tr("Copy");
                    enabled: root.original != ""; clicked => { root.copy-result(); }
                }
                Button {
                    text: root.selected-line >= 0 ? @tr("Translate Line") : @tr("Translate Paragraph");
                    accessible-description: @tr("Translate with {0}", root.service);
                    horizontal-stretch: 1;
                    visible: !root.scan-mode && root.service != "";
                    enabled: !root.busy && root.selected-paragraph >= 0;
                    clicked => { root.translate(); }
                }
                Button { text: @tr("Close"); clicked => { root.dismiss(); } }
            }
        }
    }
}
