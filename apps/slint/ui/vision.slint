import { Button, CheckBox, ListView, TextEdit, VerticalBox } from "std-widgets.slint";
import { ClippyTheme } from "theme.slint";
import { ClippyWindow } from "window.slint";

export struct TextBox {
    line: int,
    paragraph: int,
    outline: string,
    left: float,
    top: float,
    width: float,
    height: float,
    translated: string,
}

export struct TextParagraph {
    id: int,
    source: string,
    translated: string,
    left: float,
    top: float,
    width: float,
    height: float,
}

component TranslationOverlay inherits Rectangle {
    in property <string> translated;
    in property <bool> active;
    visible: root.active && root.translated != "" && root.width > 60px && root.height > 16px
        && translated-text.min-width <= root.width && translated-text.preferred-height <= root.height;
    clip: true;
    background: #fffffff2;
    translated-text := Text {
        width: parent.width;
        height: self.preferred-height;
        font-size: clamp(parent.height / 3, 12px, 20px);
        text: root.translated;
        color: #1c1d22;
        wrap: word-wrap;
    }
}

export component ImageTextWindow inherits ClippyWindow {
    in property <image> picture;
    in property <float> image-width: 1;
    in property <float> image-height: 1;
    in property <[TextBox]> boxes;
    in property <[TextParagraph]> paragraphs;
    in property <string> original;
    in property <string> current-text;
    in property <string> service;
    in property <string> status;
    in property <bool> busy;
    in-out property <int> selected-line: -1;
    in-out property <int> selected-paragraph: -1;
    in-out property <bool> show-translation: true;
    callback select-line(int);
    callback select-paragraph(int);
    callback copy-result();
    callback translate();
    callback dismiss();

    title: "Clippy Image Text";
    heading: "Image Text";
    dismiss-window => { root.dismiss(); }
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 500px;
    min-height: 420px;

    HorizontalLayout {
        spacing: 10px;
        padding: 12px;
        vertical-stretch: 1;
        Rectangle {
            horizontal-stretch: 1;
            background: #252932;
            border-radius: 6px;
            depiction := Image {
                width: min(parent.width, parent.height * root.image-width / root.image-height);
                height: self.width * root.image-height / root.image-width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.picture;
                image-fit: fill;
                for box in root.boxes: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: root.image-width;
                    viewbox-height: root.image-height;
                    commands: box.outline;
                    stroke: box.line == root.selected-line ? #ffd158 : #29a7ef;
                    stroke-width: box.line == root.selected-line ? 2px : 1px;
                    fill: transparent;
                }
                for box in root.boxes: TouchArea {
                    x: box.left * depiction.width;
                    y: box.top * depiction.height;
                    width: box.width * depiction.width;
                    height: box.height * depiction.height;
                    clicked => { root.select-line(box.line); }
                }
                for result in root.paragraphs: TranslationOverlay {
                    x: result.left * depiction.width;
                    y: result.top * depiction.height;
                    width: result.width * depiction.width;
                    height: result.height * depiction.height;
                    active: root.show-translation && (root.selected-line < 0 || root.selected-paragraph != result.id);
                    translated: result.translated;
                }
                for box in root.boxes: TranslationOverlay {
                    x: box.left * depiction.width;
                    y: box.top * depiction.height;
                    width: box.width * depiction.width;
                    height: box.height * depiction.height;
                    active: root.show-translation && box.line == root.selected-line;
                    translated: box.translated;
                }
            }
        }
        VerticalBox {
            width: 360px;
            padding: 0;
            spacing: 7px;
            Text { text: root.status; wrap: word-wrap; color: ClippyTheme.muted; }
            ListView {
                for result in root.paragraphs: Rectangle {
                    height: max(53px, 12px + source-label.height + (translation-label.visible ? 4px + translation-label.height : 0px));
                    clip: true;
                    background: root.selected-paragraph == result.id ? ClippyTheme.accent-soft : ClippyTheme.surface;
                    TouchArea { clicked => { root.select-paragraph(result.id); } }
                    source-label := Text {
                        x: 6px; y: 6px; width: parent.width - 12px; height: self.preferred-height;
                        text: result.source; wrap: word-wrap; overflow: elide; max-lines: 3; color: ClippyTheme.foreground;
                    }
                    translation-label := Text {
                        x: 6px; y: source-label.y + source-label.height + 4px;
                        width: parent.width - 12px; height: self.preferred-height;
                        visible: result.translated != "";
                        text: result.translated; wrap: word-wrap; overflow: elide; max-lines: 3; color: ClippyTheme.accent;
                    }
                }
            }
            TextEdit {
                text: root.current-text == "" ? root.original : root.current-text;
                read-only: true;
                wrap: word-wrap;
                height: 110px;
            }
            CheckBox { text: "Show translation on image"; checked <=> root.show-translation; }
            HorizontalLayout {
                spacing: 7px;
                Button { text: "Copy"; enabled: root.original != ""; clicked => { root.copy-result(); } }
                Button {
                    text: root.selected-line >= 0 ? "Translate Line" : "Translate Paragraph";
                    accessible-description: "Translate with " + root.service;
                    horizontal-stretch: 1;
                    visible: root.service != "";
                    enabled: !root.busy && root.selected-paragraph >= 0;
                    clicked => { root.translate(); }
                }
                Button { text: "Close"; clicked => { root.dismiss(); } }
            }
        }
    }
}
