import { Button, ComboBox, LineEdit, ListView, VerticalBox } from "std-widgets.slint";
import { ClippyTheme } from "theme.slint";
import { ClippyWindow } from "window.slint";

export struct RecordingRow { key: string, title: string, detail: string, has-artifact: bool, can-merge: bool }

export component RecordingLibrary inherits ClippyWindow {
    in property <[RecordingRow]> recordings;
    in-out property <string> selected;
    in-out property <bool> can-play;
    in-out property <bool> can-merge;
    in property <bool> recording;
    in property <bool> paused;
    in property <bool> toggle-pending;
    in property <bool> finishing;
    in property <bool> loaded;
    in property <string> status;
    in property <[string]> audio-options;
    in-out property <int> audio-index;
    callback audio-changed(int);
    callback play(string);
    callback export-recording(string, string);
    callback remove-recording(string);
    callback merge-recording(string);
    callback reload();
    callback pause();
    callback stop();
    callback dismiss();

    title: "Clippy Recordings";
    heading: "Recordings";
    dismiss-window => { root.dismiss(); }
    preferred-width: 640px;
    preferred-height: 500px;

    VerticalBox {
        padding: 16px;
        spacing: 8px;
        vertical-stretch: 1;
        HorizontalLayout {
            spacing: 8px;
            if root.recording: Button {
                text: root.paused ? "Resume" : "Pause";
                width: 90px;
                enabled: !root.toggle-pending && !root.finishing;
                clicked => { root.pause(); }
            }
            if root.recording: Button {
                text: root.finishing ? "Finalizing…" : "Stop";
                width: 104px;
                enabled: !root.finishing;
                clicked => { root.stop(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Refresh"; clicked => { root.reload(); } }
        }
        if root.audio-options.length > 1: HorizontalLayout {
            spacing: 8px;
            Text { text: "Next recording"; vertical-alignment: center; color: ClippyTheme.foreground; }
            ComboBox {
                model: root.audio-options;
                current-index <=> root.audio-index;
                selected => { root.audio-changed(self.current-index); }
            }
        }
        if root.recordings.length == 0: Text {
            text: root.loaded ? "No recordings yet" : "Loading recordings…";
            color: ClippyTheme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if root.recordings.length > 0: ListView {
            for row in root.recordings: Rectangle {
                height: 62px;
                border-radius: 5px;
                background: root.selected == row.key ? ClippyTheme.accent-soft : ClippyTheme.surface;
                TouchArea {
                    clicked => {
                        root.selected = row.key;
                        root.can-play = row.has-artifact;
                        root.can-merge = row.can-merge;
                    }
                    double-clicked => { if row.has-artifact { root.play(row.key); } }
                }
                VerticalLayout {
                    padding: 8px;
                    Text { text: row.title; color: ClippyTheme.foreground; overflow: elide; }
                    Text { text: row.detail; font-size: 12px; color: ClippyTheme.muted; overflow: elide; }
                }
            }
        }
        destination := LineEdit {
            enabled: root.can-play;
            placeholder-text: "Optional export destination directory";
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Play"; enabled: root.can-play; clicked => { root.play(root.selected); } }
            Button { text: "Export"; enabled: root.can-play; clicked => { root.export-recording(root.selected, destination.text); } }
            if root.can-merge: Button { text: "Recover"; enabled: !root.recording; clicked => { root.merge-recording(root.selected); } }
            Button { text: "Delete"; enabled: root.selected != "" && !root.recording; clicked => { root.remove-recording(root.selected); } }
            Button { text: "Close"; clicked => { root.dismiss(); } }
        }
        Text {
            text: root.finishing ? "Finalizing recording…" : root.status;
            color: ClippyTheme.muted;
            wrap: word-wrap;
            min-height: 18px;
        }
    }
}
