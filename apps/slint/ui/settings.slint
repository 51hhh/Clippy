import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ScrollView, Switch } from "std-widgets.slint";
import { ClippyTheme, SurfaceButton } from "theme.slint";

export struct GeneralSettings {
    max-history: string,
    panel-shortcut: string,
    pin-shortcut: string,
    capture-shortcut: string,
    theme: int,
    language: int,
    save-directory: string,
    filename-template: string,
    ocr-enabled: bool,
    ocr-manifest: string,
}

export struct TranslationSettings {
    enabled: bool,
    endpoint: string,
    model: string,
    region: string,
    project: string,
    source: string,
    target: string,
}

export enum ShortcutField { none, clipboard, pin, screenshot }
export enum FileChoice { screenshot-directory, ocr-manifest, export-archive, import-archive }
export enum GnomeHelperAction { refresh, install, enable, disable, remove }
export struct GnomeHelperView {
    title: string, detail: string, action: GnomeHelperAction, action-label: string, removable: bool,
}
export struct PortalShortcutView {
    available: bool, configurable: bool, detail: string, open: string, pin: string, capture: string,
}
export struct OcrStatus {
    title: string, detail: string, checking: bool,
}

component FieldLabel inherits Text {
    color: ClippyTheme.foreground;
    font-size: 14px;
    font-weight: 600;
}

component SettingDivider inherits Rectangle {
    height: 49px;
    Rectangle {
        y: 24px;
        height: 1px;
        background: ClippyTheme.border;
    }
}

component SettingInput inherits LineEdit {
    height: 42px;
    font-size: 14px;
}

component SettingHint inherits Text {
    color: ClippyTheme.subtle;
    font-size: 12px;
    wrap: word-wrap;
}

component CapabilityLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> desktop-permission;
    height: 34px;
    border-radius: 6px;
    background: ClippyTheme.surface;
    Rectangle {
        width: 3px; height: parent.height; border-radius: 2px;
        background: root.desktop-permission ? #d97706 : #16a34a;
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 8px;
        Text { text: root.label; color: ClippyTheme.foreground; vertical-alignment: center; horizontal-stretch: 1; font-size: 13px; }
        Text { text: root.value; color: ClippyTheme.foreground; vertical-alignment: center; font-size: 13px; font-weight: 650; }
    }
}

component SectionRule inherits Rectangle {
    height: 1px;
    background: ClippyTheme.border;
}

component DesktopShortcuts inherits VerticalLayout {
    in property <PortalShortcutView> view;
    in property <bool> screenshot-only;
    callback configure();
    spacing: 8px;
    FieldLabel { text: root.screenshot-only ? @tr("Screenshot Shortcut") : @tr("Global Shortcuts"); }
    SettingHint { text: root.view.detail; }
    if root.view.available && !root.screenshot-only: CapabilityLine {
        label: @tr("Open Clipboard");
        value: root.view.open == "" ? @tr("Not assigned") : root.view.open;
        desktop-permission: true;
    }
    if root.view.available && !root.screenshot-only: CapabilityLine {
        label: @tr("Pin Item");
        value: root.view.pin == "" ? @tr("Not assigned") : root.view.pin;
        desktop-permission: true;
    }
    if root.view.available: CapabilityLine {
        label: @tr("Screenshot");
        value: root.view.capture == "" ? @tr("Not assigned") : root.view.capture;
        desktop-permission: true;
    }
    if root.view.configurable: Button {
        text: @tr("Configure Desktop Shortcuts");
        clicked => { root.configure(); }
    }
}

component ShortcutInput inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> reset-value;
    in property <bool> recording;
    in-out property <string> value;
    callback record();

    spacing: 9px;
    FieldLabel { text: root.label; }
    HorizontalLayout {
        spacing: 8px;
        SettingInput { text <=> root.value; accessible-label: root.label; read-only: root.recording; }
        SurfaceButton {
            label: root.recording ? @tr("Cancel") : @tr("Record");
            selected: root.recording;
            width: 71px; height: 42px;
            clicked => { root.record(); }
        }
        SurfaceButton {
            label: @tr("Reset"); width: 64px; height: 42px;
            border-width: 1px; border-color: ClippyTheme.border; border-radius: 8px;
            enabled: !root.recording;
            clicked => { root.value = root.reset-value; }
        }
    }
    SettingHint {
        text: root.recording ? @tr("Press a shortcut. Esc cancels.") : root.hint;
        color: root.recording ? ClippyTheme.accent : ClippyTheme.subtle;
    }
}

component ThemeCard inherits SurfaceButton {
    in property <int> theme;
    caption: "";
    height: 78px;
    horizontal-stretch: 1;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? ClippyTheme.highlight : ClippyTheme.border;

    Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: 41px;
        border-radius: 6px;
        background: ClippyTheme.theme-background(root.theme);
        border-color: ClippyTheme.border;
        border-width: 1px;
        Rectangle {
            x: 8px; y: 7px; width: parent.width * 0.44; height: 4px;
            border-radius: 2px;
            background: ClippyTheme.theme-highlight(root.theme);
        }
        Rectangle {
            x: 8px; y: 18px; width: parent.width * 0.65; height: 4px;
            border-radius: 2px;
            background: ClippyTheme.theme-highlight(root.theme).with-alpha(0.25);
        }
        Rectangle {
            x: 8px; y: 28px; width: parent.width * 0.52; height: 4px;
            border-radius: 2px;
            background: ClippyTheme.theme-highlight(root.theme).with-alpha(0.16);
        }
    }
    Text {
        x: 9px; y: 55px; width: parent.width - 18px;
        text: root.label;
        color: ClippyTheme.foreground;
        font-size: 12px;
        font-weight: 500;
        overflow: elide;
    }
}

export component SettingsPane inherits Rectangle {
    in property <GeneralSettings> general;
    in property <TranslationSettings> translation;
    in property <int> provider-index;
    in property <bool> auto-paste;
    in property <bool> autostart;
    in property <bool> autostart-available;
    in property <bool> tmux-available;
    in property <bool> busy;
    in property <bool> file-dialog-pending;
    in property <[string]> shortcut-defaults;
    in property <bool> wayland-session;
    in property <bool> gnome-session;
    in property <bool> save-pending;
    in property <bool> gnome-helper-busy;
    in property <GnomeHelperView> gnome-helper;
    in property <PortalShortcutView> portal-shortcuts;
    in property <OcrStatus> ocr-status;
    in property <string> build-label;
    in property <string> data-status;
    in-out property <ShortcutField> recording-shortcut;
    in-out property <string> panel-shortcut;
    in-out property <string> pin-shortcut;
    in-out property <string> capture-shortcut;
    in-out property <string> save-directory-draft;
    in-out property <string> ocr-manifest-draft;
    callback paste-setting(bool);
    callback authorize-paste();
    callback forget-paste();
    callback gnome-helper-action(GnomeHelperAction);
    callback configure-portal-shortcuts();
    callback set-autostart(bool);
    callback apply-general(GeneralSettings);
    callback select-provider(int);
    callback apply-translation(int, TranslationSettings);
    callback store-credentials(int, string, string);
    callback delete-credentials(int);
    callback data-action(int, string);
    callback clear-clipboard-history();
    callback choose-path(FileChoice, string);
    callback refresh-ocr-status();
    private property <int> page;
    private property <bool> confirm-history-clear;
    private property <bool> desktop-managed-shortcuts: root.wayland-session && !root.gnome-session;
    private property <[string]> pages: [@tr("General"), @tr("Screenshot"), @tr("Translation"), @tr("About")];
    private property <[string]> themes: [@tr("Light"), @tr("Dark"), "Nord", @tr("Solarized Light"), @tr("Rose"), @tr("Midnight")];
    private property <int> selected-theme: root.general.theme;
    private property <int> selected-language: root.general.language;
    private property <int> theme-columns: root.width >= 590px ? 4 : 3;
    changed general => {
        if root.page == 1 { root.refresh-ocr-status(); }
    }

    VerticalLayout {
        x: max(18px, (root.width - 616px) / 2);
        y: 0px;
        width: root.width - self.x * 2;
        height: root.height;
        padding-top: 36px;
        padding-bottom: 14px;
        spacing: 28px;
        Rectangle {
            height: 42px;
            border-radius: 12px;
            background: ClippyTheme.surface;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                for title[index] in root.pages: SurfaceButton {
                    label: title;
                    horizontal-stretch: 1;
                    selected: root.page == index;
                    background: self.selected ? ClippyTheme.background : ClippyTheme.surface;
                    border-width: self.selected ? 1px : 0px;
                    border-color: ClippyTheme.border;
                    clicked => {
                        root.page = index;
                        root.confirm-history-clear = false;
                        root.recording-shortcut = ShortcutField.none;
                        page-scroll.content-y = 0px;
                        if index == 1 && root.wayland-session && root.gnome-session {
                            root.gnome-helper-action(GnomeHelperAction.refresh);
                        }
                        if index == 1 { root.refresh-ocr-status(); }
                        if index == 3 { root.data-action(0, ""); }
                    }
                }
            }
        }
        page-scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                spacing: 8px;
                if root.page == 0: VerticalLayout {
                    spacing: 7px;
                    if root.desktop-managed-shortcuts: DesktopShortcuts {
                        view: root.portal-shortcuts;
                        configure => { root.configure-portal-shortcuts(); }
                    }
                    if !root.desktop-managed-shortcuts: ShortcutInput {
                        label: @tr("Global Shortcut");
                        hint: @tr("Click Record, then press your desired key combination.");
                        reset-value: root.shortcut-defaults[0];
                        value <=> root.panel-shortcut;
                        recording: root.recording-shortcut == ShortcutField.clipboard;
                        record => { root.recording-shortcut = self.recording ? ShortcutField.none : ShortcutField.clipboard; }
                    }
                    if !root.desktop-managed-shortcuts: SettingDivider { }
                    if !root.desktop-managed-shortcuts: ShortcutInput {
                        label: @tr("Pin Shortcut");
                        hint: @tr("Pin the focused clipboard item to the desktop.");
                        reset-value: root.shortcut-defaults[1];
                        value <=> root.pin-shortcut;
                        recording: root.recording-shortcut == ShortcutField.pin;
                        record => { root.recording-shortcut = self.recording ? ShortcutField.none : ShortcutField.pin; }
                    }
                    SettingDivider { }
                    FieldLabel { text: @tr("Theme"); }
                    HorizontalLayout {
                        spacing: 10px;
                        for index in root.theme-columns: ThemeCard {
                            theme: index;
                            label: root.themes[index];
                            selected: root.selected-theme == index;
                            clicked => { root.selected-theme = index; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for index in 6 - root.theme-columns: ThemeCard {
                            theme: index + root.theme-columns;
                            label: root.themes[index + root.theme-columns];
                            selected: root.selected-theme == index + root.theme-columns;
                            clicked => { root.selected-theme = index + root.theme-columns; }
                        }
                        for item in 2 * root.theme-columns - 6: Rectangle { horizontal-stretch: 1; }
                    }
                    SettingDivider { }
                    FieldLabel { text: @tr("History Limit"); }
                    history := SettingInput { text: root.general.max-history; input-type: number; accessible-label: @tr("History Limit"); }
                    SettingHint { text: @tr("0 = unlimited. Favorites are kept."); }
                    FieldLabel { text: @tr("Interface language"); }
                    ComboBox {
                        accessible-label: @tr("Interface language");
                        model: [@tr("Follow system"), "English", "简体中文"];
                        current-index <=> root.selected-language;
                    }
                    SettingDivider { }
                    CheckBox {
                        text: @tr("Enable automatic paste");
                        checked: root.auto-paste;
                        enabled: !root.busy && !root.save-pending;
                        toggled => { root.paste-setting(self.checked); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: @tr("Authorize paste"); enabled: root.auto-paste && !root.busy; clicked => { root.authorize-paste(); } }
                        Button { text: @tr("Forget paste permission"); enabled: !root.busy; clicked => { root.forget-paste(); } }
                    }
                    CheckBox {
                        text: @tr("Start at login");
                        checked: root.autostart;
                        enabled: root.autostart-available;
                        toggled => { root.set-autostart(self.checked); }
                    }
                    Button {
                        text: @tr("Save general settings");
                        enabled: !root.save-pending;
                        clicked => {
                            root.recording-shortcut = ShortcutField.none;
                            root.apply-general({
                                max-history: history.text, panel-shortcut: root.panel-shortcut,
                                pin-shortcut: root.pin-shortcut,
                                theme: root.selected-theme, capture-shortcut: root.general.capture-shortcut,
                                language: root.selected-language,
                                save-directory: root.general.save-directory, filename-template: root.general.filename-template,
                                ocr-enabled: root.general.ocr-enabled, ocr-manifest: root.general.ocr-manifest,
                            });
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 8px;
                    FieldLabel { text: @tr("Screen Capture Service"); }
                    Rectangle {
                        height: 113px; border-radius: 12px; border-width: 1px;
                        border-color: ClippyTheme.border; background: ClippyTheme.surface;
                        Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; border-radius: 2px; background: ClippyTheme.subtle; }
                        VerticalLayout {
                            padding: 15px; spacing: 8px; alignment: start;
                            FieldLabel {
                                text: !root.wayland-session ? @tr("Not needed on this desktop")
                                    : root.gnome-session ? @tr("GNOME capture is selected") : @tr("Using the desktop portal");
                            }
                            Text {
                                color: ClippyTheme.muted; font-size: 13px; wrap: word-wrap;
                                text: !root.wayland-session ? @tr("Clippy reads the screen with the native desktop API.")
                                    : @tr("The compositor provides the screen pixels. Your desktop controls capture permissions.");
                            }
                            SurfaceButton {
                                label: @tr("Diagnostics"); width: 88px; height: 28px;
                                border-width: 1px; border-color: ClippyTheme.border;
                                clicked => { root.page = 3; page-scroll.content-y = 0px; root.data-action(4, ""); }
                            }
                        }
                    }
                    SettingHint { text: @tr("The screenshot shortcut uses the fast native capture path. System Screenshot opens the desktop’s own selector on Wayland."); }
                    if root.wayland-session && root.gnome-session: VerticalLayout {
                        spacing: 8px;
                        FieldLabel { text: @tr("GNOME Window Picking"); }
                        Rectangle {
                            height: 116px; border-radius: 12px; border-width: 1px;
                            border-color: ClippyTheme.border; background: ClippyTheme.surface;
                            VerticalLayout {
                                padding: 15px; spacing: 6px; alignment: start;
                                FieldLabel {
                                    text: root.gnome-helper-busy ? @tr("Checking helper…") : root.gnome-helper.title;
                                }
                                SettingHint { text: root.gnome-helper.detail; }
                                HorizontalLayout {
                                    alignment: start; spacing: 8px;
                                    if root.gnome-helper.action-label != "": SurfaceButton {
                                        label: root.gnome-helper.action-label; height: 28px;
                                        primary: true; enabled: !root.gnome-helper-busy;
                                        clicked => { root.gnome-helper-action(root.gnome-helper.action); }
                                    }
                                    SurfaceButton {
                                        label: @tr("Refresh"); height: 28px;
                                        enabled: !root.gnome-helper-busy;
                                        clicked => { root.gnome-helper-action(GnomeHelperAction.refresh); }
                                    }
                                    if root.gnome-helper.removable: SurfaceButton {
                                        label: @tr("Remove"); height: 28px; danger: true;
                                        enabled: !root.gnome-helper-busy;
                                        clicked => { root.gnome-helper-action(GnomeHelperAction.remove); }
                                    }
                                }
                            }
                        }
                    }
                    SettingDivider { }
                    if root.desktop-managed-shortcuts: DesktopShortcuts {
                        view: root.portal-shortcuts;
                        screenshot-only: true;
                        configure => { root.configure-portal-shortcuts(); }
                    }
                    if !root.desktop-managed-shortcuts: ShortcutInput {
                        label: @tr("Screenshot Shortcut");
                        hint: @tr("Shortcut to start a screenshot.");
                        reset-value: root.shortcut-defaults[2];
                        value <=> root.capture-shortcut;
                        recording: root.recording-shortcut == ShortcutField.screenshot;
                        record => { root.recording-shortcut = self.recording ? ShortcutField.none : ShortcutField.screenshot; }
                    }
                    SettingDivider { }
                    FieldLabel { text: @tr("Screenshots"); }
                    FieldLabel { text: @tr("Screenshot directory"); }
                    HorizontalLayout {
                        spacing: 8px;
                        SettingInput {
                            text <=> root.save-directory-draft;
                            placeholder-text: @tr("System Pictures/Screenshots");
                            enabled: !root.file-dialog-pending;
                        }
                        SurfaceButton {
                            label: @tr("Browse screenshot directory"); caption: @tr("Browse…");
                            enabled: !root.file-dialog-pending && !root.save-pending;
                            clicked => { root.choose-path(FileChoice.screenshot-directory, root.save-directory-draft); }
                        }
                    }
                    FieldLabel { text: @tr("Screenshot filename template"); }
                    filename := SettingInput { text: root.general.filename-template; placeholder-text: "{prefix}-{date}-{time}"; }
                    ocr := CheckBox { text: @tr("Enable OCR"); checked: root.general.ocr-enabled; }
                    HorizontalLayout {
                        spacing: 8px;
                        FieldLabel {
                            text: root.ocr-status.title;
                            vertical-alignment: center; horizontal-stretch: 1;
                        }
                        SurfaceButton {
                            label: @tr("Recheck OCR");
                            enabled: root.general.ocr-enabled && !root.ocr-status.checking;
                            clicked => { root.refresh-ocr-status(); }
                        }
                    }
                    if root.ocr-status.detail != "": SettingHint { text: root.ocr-status.detail; }
                    FieldLabel { text: @tr("Enhanced OCR manifest"); }
                    HorizontalLayout {
                        spacing: 8px;
                        SettingInput {
                            text <=> root.ocr-manifest-draft;
                            placeholder-text: @tr("Optional path to model manifest");
                            accessible-label: @tr("Enhanced OCR manifest");
                            enabled: !root.file-dialog-pending;
                        }
                        SurfaceButton {
                            label: @tr("Browse OCR manifest"); caption: @tr("Browse…");
                            enabled: !root.file-dialog-pending && !root.save-pending;
                            clicked => { root.choose-path(FileChoice.ocr-manifest, root.ocr-manifest-draft); }
                        }
                    }
                    if ocr.checked != root.general.ocr-enabled || root.ocr-manifest-draft != root.general.ocr-manifest: SettingHint {
                        text: @tr("Save to apply the OCR changes.");
                    }
                    Button {
                        text: @tr("Save screenshot settings");
                        enabled: !root.save-pending && !root.file-dialog-pending;
                        clicked => {
                            root.recording-shortcut = ShortcutField.none;
                            root.apply-general({
                                max-history: root.general.max-history, panel-shortcut: root.general.panel-shortcut,
                                pin-shortcut: root.general.pin-shortcut,
                                theme: root.general.theme, capture-shortcut: root.capture-shortcut,
                                language: root.general.language,
                                save-directory: root.save-directory-draft, filename-template: filename.text,
                                ocr-enabled: ocr.checked, ocr-manifest: root.ocr-manifest-draft,
                            });
                        }
                    }
                }
                if root.page == 2: VerticalLayout {
                    spacing: 11px;
                    FieldLabel { text: @tr("Translation"); }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 5px; horizontal-stretch: 1;
                            SettingHint { text: @tr("Provider"); color: ClippyTheme.muted; }
                            ComboBox {
                                height: 42px;
                                model: [@tr("LibreTranslate-compatible"), @tr("OpenAI-compatible"), "DeepL", "Google", "Bing", @tr("Youdao")];
                                current-index: root.provider-index;
                                selected => {
                                    key.text = "";
                                    secret.text = "";
                                    root.select-provider(self.current-index);
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 5px; horizontal-stretch: 1;
                            SettingHint { text: @tr("Enable"); color: ClippyTheme.muted; }
                            HorizontalLayout {
                                spacing: 8px; height: 42px;
                                preferred := Switch { checked: root.translation.enabled; }
                                SettingHint { text: @tr("Use this service for quick translation."); vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                    }
                    SettingHint { text: @tr("Endpoint"); color: ClippyTheme.muted; }
                    endpoint := SettingInput { text: root.translation.endpoint; placeholder-text: @tr("Provider default"); }
                    SettingHint { text: @tr("Requests are sent only to this service endpoint."); }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 6px;
                            SettingHint { text: @tr("Source Language"); color: ClippyTheme.muted; }
                            source := SettingInput { text: root.translation.source; placeholder-text: @tr("Detect automatically"); }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            SettingHint { text: @tr("Target Language"); color: ClippyTheme.muted; }
                            target := SettingInput { text: root.translation.target; placeholder-text: @tr("English (en)"); }
                        }
                    }
                    SettingHint { text: @tr("Use a language code such as en, zh-Hans or ja."); }
                    SettingDivider { }
                    if root.provider-index == 1: FieldLabel { text: @tr("Model"); }
                    model := SettingInput {
                        text: root.translation.model;
                        visible: root.provider-index == 1;
                        height: self.visible ? 42px : 0px;
                    }
                    if root.provider-index == 4 || root.provider-index == 5: FieldLabel { text: @tr("Region / project"); }
                    HorizontalLayout {
                        spacing: 6px;
                        region := SettingInput {
                            text: root.translation.region; placeholder-text: @tr("Region");
                            visible: root.provider-index == 4 || root.provider-index == 5;
                            height: self.visible ? 42px : 0px;
                        }
                        project := SettingInput {
                            text: root.translation.project; placeholder-text: @tr("Project");
                            visible: region.visible;
                            height: self.visible ? 42px : 0px;
                        }
                    }
                    Button {
                        text: @tr("Save provider settings");
                        enabled: !root.save-pending;
                        clicked => {
                            root.apply-translation(root.provider-index, {
                                enabled: preferred.checked, endpoint: endpoint.text, model: model.text, region: region.text,
                                project: project.text, source: source.text, target: target.text,
                            });
                        }
                    }
                    FieldLabel { text: @tr("System keychain"); }
                    key := LineEdit { placeholder-text: @tr("API key"); input-type: password; }
                    secret := LineEdit { placeholder-text: @tr("API secret · Youdao"); input-type: password; }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: @tr("Store credentials"); enabled: !key.text.is-empty && !root.busy;
                            clicked => {
                                root.store-credentials(root.provider-index, key.text, secret.text);
                                key.text = "";
                                secret.text = "";
                            }
                        }
                        Button { text: @tr("Delete stored credentials"); enabled: !root.busy; clicked => { root.delete-credentials(root.provider-index); } }
                    }
                }
                if root.page == 3: VerticalLayout {
                    spacing: 7px;
                    FieldLabel { text: @tr("About"); }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 34px; border-radius: 6px; border-width: 1px;
                            border-color: ClippyTheme.border; background: ClippyTheme.surface;
                            Text {
                                x: 10px; width: parent.width - 20px; height: parent.height;
                                text: root.build-label; color: ClippyTheme.foreground; font-size: 13px;
                                font-weight: 600; vertical-alignment: center; overflow: elide;
                            }
                        }
                    }
                    SettingDivider { }
                    FieldLabel { text: @tr("Platform Capabilities"); }
                    SettingHint { text: root.wayland-session ? @tr("Wayland · desktop permissions apply") : @tr("Native desktop session"); }
                    CapabilityLine { label: @tr("Text clipboard"); value: @tr("Available"); }
                    CapabilityLine { label: @tr("Image clipboard"); value: @tr("Available"); }
                    CapabilityLine {
                        label: @tr("Automatic paste"); value: root.wayland-session ? @tr("Desktop permission") : @tr("Native input");
                        desktop-permission: root.wayland-session;
                    }
                    CapabilityLine {
                        label: @tr("Global shortcuts");
                        value: root.wayland-session && !root.gnome-session ? @tr("Desktop permission") : @tr("Native registration");
                        desktop-permission: root.wayland-session && !root.gnome-session;
                    }
                    CapabilityLine { label: @tr("Screen capture"); value: @tr("Native capture"); }
                    SettingDivider { }
                    AboutSlint { height: self.min-height; }
                    SectionRule { }
                    FieldLabel { text: @tr("Data and Backups"); }
                    FieldLabel { text: root.data-status; wrap: word-wrap; }
                    archive := LineEdit {
                        placeholder-text: @tr("Optional absolute .clippy.zip path");
                        enabled: !root.file-dialog-pending;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: @tr("Export archive"); enabled: !root.busy && !root.file-dialog-pending;
                            clicked => {
                                if archive.text.is-empty {
                                    root.choose-path(FileChoice.export-archive, "");
                                } else {
                                    root.data-action(1, archive.text);
                                }
                            }
                        }
                        Button {
                            text: @tr("Import archive"); enabled: !root.busy && !root.file-dialog-pending;
                            clicked => {
                                if archive.text.is-empty {
                                    root.choose-path(FileChoice.import-archive, "");
                                } else {
                                    root.data-action(2, archive.text);
                                }
                            }
                        }
                    }
                    if !root.confirm-history-clear: Button {
                        text: @tr("Clear clipboard history");
                        enabled: !root.busy && !root.file-dialog-pending;
                        clicked => { root.confirm-history-clear = true; }
                    }
                    if root.confirm-history-clear: HorizontalLayout {
                        spacing: 8px;
                        SettingHint {
                            text: @tr("Delete all non-favorite clips?");
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.confirm-history-clear = false; }
                        }
                        Button {
                            text: @tr("Delete permanently");
                            enabled: !root.busy && !root.file-dialog-pending;
                            clicked => {
                                root.confirm-history-clear = false;
                                root.clear-clipboard-history();
                            }
                        }
                    }
                    if root.tmux-available: Button { text: @tr("Capture active tmux pane"); enabled: !root.busy; clicked => { root.data-action(3, ""); } }
                    Button { text: @tr("Diagnostics"); clicked => { root.data-action(4, ""); } }
                }
            }
        }
    }
}
