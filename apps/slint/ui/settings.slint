import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { ClippyTheme, SurfaceButton } from "theme.slint";

export struct GeneralSettings {
    max-history: string,
    panel-shortcut: string,
    capture-shortcut: string,
    theme: int,
    save-directory: string,
    filename-template: string,
    ocr-enabled: bool,
    ocr-manifest: string,
}

export struct TranslationSettings {
    enabled: bool,
    endpoint: string,
    model: string,
    region: string,
    project: string,
    source: string,
    target: string,
}

export enum ShortcutField { none, clipboard, screenshot }

component FieldLabel inherits Text {
    color: ClippyTheme.foreground;
    font-size: 14px;
    font-weight: 600;
}

component SettingDivider inherits Rectangle {
    height: 1px;
    background: ClippyTheme.border;
}

component ShortcutInput inherits VerticalLayout {
    in property <string> label;
    in property <bool> recording;
    in-out property <string> value;
    callback record();

    spacing: 6px;
    FieldLabel { text: root.label; }
    HorizontalLayout {
        spacing: 8px;
        LineEdit { text <=> root.value; accessible-label: root.label; read-only: root.recording; }
        SurfaceButton {
            label: root.recording ? "Cancel recording" : "Record shortcut";
            selected: root.recording;
            width: 121px;
            clicked => { root.record(); }
        }
    }
    if root.recording: Text {
        text: "Press a shortcut. Esc cancels.";
        color: ClippyTheme.accent;
        font-size: 12px;
    }
}

component ThemeCard inherits SurfaceButton {
    in property <int> theme;
    caption: "";
    height: 78px;
    horizontal-stretch: 1;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? ClippyTheme.highlight : ClippyTheme.border;

    Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: 41px;
        border-radius: 6px;
        background: ClippyTheme.theme-background(root.theme);
        border-color: ClippyTheme.border;
        border-width: 1px;
        Rectangle {
            x: 8px; y: 7px; width: parent.width * 0.44; height: 4px;
            border-radius: 2px;
            background: ClippyTheme.theme-highlight(root.theme);
        }
        Rectangle {
            x: 8px; y: 18px; width: parent.width * 0.65; height: 4px;
            border-radius: 2px;
            background: ClippyTheme.theme-highlight(root.theme).with-alpha(0.25);
        }
        Rectangle {
            x: 8px; y: 28px; width: parent.width * 0.52; height: 4px;
            border-radius: 2px;
            background: ClippyTheme.theme-highlight(root.theme).with-alpha(0.16);
        }
    }
    Text {
        x: 9px; y: 55px; width: parent.width - 18px;
        text: root.label;
        color: ClippyTheme.foreground;
        font-size: 12px;
        font-weight: 500;
        overflow: elide;
    }
}

export component SettingsPane inherits Rectangle {
    in property <GeneralSettings> general;
    in property <TranslationSettings> translation;
    in property <int> provider-index;
    in property <bool> auto-paste;
    in property <bool> autostart;
    in property <bool> autostart-available;
    in property <bool> tmux-available;
    in property <bool> busy;
    in property <string> build-label;
    in property <string> data-status;
    in-out property <ShortcutField> recording-shortcut;
    in-out property <string> panel-shortcut;
    in-out property <string> capture-shortcut;
    callback paste-setting(bool);
    callback authorize-paste();
    callback forget-paste();
    callback set-autostart(bool);
    callback apply-general(GeneralSettings);
    callback select-provider(int);
    callback apply-translation(int, TranslationSettings);
    callback store-credentials(int, string, string);
    callback delete-credentials(int);
    callback data-action(int, string);
    private property <int> page;
    private property <[string]> pages: ["General", "Screenshot", "Translation", "About"];
    private property <[string]> themes: ["Light", "Dark", "Nord", "Solarized Light", "Rose", "Midnight"];
    private property <int> selected-theme: root.general.theme;

    VerticalLayout {
        x: max(18px, (root.width - 616px) / 2);
        y: 0px;
        width: root.width - self.x * 2;
        height: root.height;
        padding-top: 28px;
        padding-bottom: 14px;
        spacing: 23px;
        Rectangle {
            height: 42px;
            border-radius: 12px;
            background: ClippyTheme.hover;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                for title[index] in root.pages: SurfaceButton {
                    label: title;
                    horizontal-stretch: 1;
                    selected: root.page == index;
                    clicked => {
                        root.page = index;
                        root.recording-shortcut = ShortcutField.none;
                        page-scroll.content-y = 0px;
                        if index == 3 { root.data-action(0, ""); }
                    }
                }
            }
        }
        page-scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                spacing: 8px;
                if root.page == 0: VerticalLayout {
                    spacing: 7px;
                    ShortcutInput {
                        label: "Global Shortcut";
                        value <=> root.panel-shortcut;
                        recording: root.recording-shortcut == ShortcutField.clipboard;
                        record => { root.recording-shortcut = self.recording ? ShortcutField.none : ShortcutField.clipboard; }
                    }
                    SettingDivider { }
                    FieldLabel { text: "Theme"; }
                    HorizontalLayout {
                        spacing: 10px;
                        for index in 3: ThemeCard {
                            theme: index;
                            label: root.themes[index];
                            selected: root.selected-theme == index;
                            clicked => { root.selected-theme = index; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for index in 3: ThemeCard {
                            theme: index + 3;
                            label: root.themes[index + 3];
                            selected: root.selected-theme == index + 3;
                            clicked => { root.selected-theme = index + 3; }
                        }
                    }
                    SettingDivider { }
                    FieldLabel { text: "History Limit"; }
                    history := LineEdit { text: root.general.max-history; input-type: number; accessible-label: "History Limit"; }
                    Text { text: "0 = unlimited. Favorites are kept."; color: ClippyTheme.muted; font-size: 12px; }
                    SettingDivider { }
                    CheckBox {
                        text: "Enable automatic paste";
                        checked: root.auto-paste;
                        enabled: !root.busy;
                        toggled => { root.paste-setting(self.checked); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Authorize paste"; enabled: root.auto-paste && !root.busy; clicked => { root.authorize-paste(); } }
                        Button { text: "Forget paste permission"; enabled: !root.busy; clicked => { root.forget-paste(); } }
                    }
                    CheckBox {
                        text: "Start at login";
                        checked: root.autostart;
                        enabled: root.autostart-available;
                        toggled => { root.set-autostart(self.checked); }
                    }
                    Button {
                        text: "Save general settings";
                        clicked => {
                            root.recording-shortcut = ShortcutField.none;
                            root.apply-general({
                                max-history: history.text, panel-shortcut: root.panel-shortcut,
                                theme: root.selected-theme, capture-shortcut: root.general.capture-shortcut,
                                save-directory: root.general.save-directory, filename-template: root.general.filename-template,
                                ocr-enabled: root.general.ocr-enabled, ocr-manifest: root.general.ocr-manifest,
                            });
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 8px;
                    ShortcutInput {
                        label: "Screenshot Shortcut";
                        value <=> root.capture-shortcut;
                        recording: root.recording-shortcut == ShortcutField.screenshot;
                        record => { root.recording-shortcut = self.recording ? ShortcutField.none : ShortcutField.screenshot; }
                    }
                    SettingDivider { }
                    FieldLabel { text: "Screenshots"; }
                    FieldLabel { text: "Screenshot directory"; }
                    directory := LineEdit { text: root.general.save-directory; placeholder-text: "System Pictures/Screenshots"; }
                    FieldLabel { text: "Screenshot filename template"; }
                    filename := LineEdit { text: root.general.filename-template; placeholder-text: "{prefix}-{date}-{time}"; }
                    ocr := CheckBox { text: "Enable OCR"; checked: root.general.ocr-enabled; }
                    FieldLabel { text: "Enhanced OCR manifest"; }
                    manifest := LineEdit { text: root.general.ocr-manifest; placeholder-text: "Optional path to model manifest"; }
                    Button {
                        text: "Save screenshot settings";
                        clicked => {
                            root.recording-shortcut = ShortcutField.none;
                            root.apply-general({
                                max-history: root.general.max-history, panel-shortcut: root.general.panel-shortcut,
                                theme: root.general.theme, capture-shortcut: root.capture-shortcut,
                                save-directory: directory.text, filename-template: filename.text,
                                ocr-enabled: ocr.checked, ocr-manifest: manifest.text,
                            });
                        }
                    }
                }
                if root.page == 2: VerticalLayout {
                    spacing: 7px;
                    ComboBox {
                        model: ["LibreTranslate", "OpenAI-compatible", "DeepL", "Google", "Bing", "Youdao"];
                        current-index: root.provider-index;
                        selected => {
                            key.text = "";
                            secret.text = "";
                            root.select-provider(self.current-index);
                        }
                    }
                    preferred := CheckBox { text: "Use this provider for quick translation"; checked: root.translation.enabled; }
                    FieldLabel { text: "Endpoint"; }
                    endpoint := LineEdit { text: root.translation.endpoint; placeholder-text: "Provider default"; }
                    FieldLabel { text: "Model"; }
                    model := LineEdit { text: root.translation.model; }
                    FieldLabel { text: "Region / project"; }
                    HorizontalLayout {
                        spacing: 6px;
                        region := LineEdit { text: root.translation.region; placeholder-text: "Region"; }
                        project := LineEdit { text: root.translation.project; placeholder-text: "Project"; }
                    }
                    FieldLabel { text: "Language codes"; }
                    HorizontalLayout {
                        spacing: 6px;
                        source := LineEdit { text: root.translation.source; placeholder-text: "Source · auto"; }
                        target := LineEdit { text: root.translation.target; placeholder-text: "Target · en"; }
                    }
                    Button {
                        text: "Save provider settings";
                        clicked => {
                            root.apply-translation(root.provider-index, {
                                enabled: preferred.checked, endpoint: endpoint.text, model: model.text, region: region.text,
                                project: project.text, source: source.text, target: target.text,
                            });
                        }
                    }
                    FieldLabel { text: "System keychain"; }
                    key := LineEdit { placeholder-text: "API key"; input-type: password; }
                    secret := LineEdit { placeholder-text: "API secret · Youdao"; input-type: password; }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: "Store credentials"; enabled: !key.text.is-empty && !root.busy;
                            clicked => {
                                root.store-credentials(root.provider-index, key.text, secret.text);
                                key.text = "";
                                secret.text = "";
                            }
                        }
                        Button { text: "Delete stored credentials"; enabled: !root.busy; clicked => { root.delete-credentials(root.provider-index); } }
                    }
                }
                if root.page == 3: VerticalLayout {
                    spacing: 8px;
                    FieldLabel { text: root.build-label; }
                    AboutSlint { height: 38px; }
                    SettingDivider { }
                    FieldLabel { text: "Data and Backups"; }
                    FieldLabel { text: root.data-status; wrap: word-wrap; }
                    archive := LineEdit { placeholder-text: "Absolute path to .clippy.zip"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Export archive"; enabled: !root.busy && !archive.text.is-empty; clicked => { root.data-action(1, archive.text); } }
                        Button { text: "Import archive"; enabled: !root.busy && !archive.text.is-empty; clicked => { root.data-action(2, archive.text); } }
                    }
                    if root.tmux-available: Button { text: "Capture active tmux pane"; enabled: !root.busy; clicked => { root.data-action(3, ""); } }
                    Button { text: "Diagnostics"; clicked => { root.data-action(4, ""); } }
                }
            }
        }
    }
}
