import { Button, CheckBox, ComboBox, LineEdit, Slider, VerticalBox } from "std-widgets.slint";
import { ClippyTheme } from "theme.slint";
import { ClippyWindow } from "window.slint";
import { ViewerPane } from "viewer.slint";

export component EditorWindow inherits ClippyWindow {
    in property <image> picture;
    in property <bool> browse;
    in property <float> aspect: 1;
    in property <[string]> tools;
    in property <int> text-tool-index;
    in property <bool> busy;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> output-ready: true;
    in-out property <bool> grayscale-value;
    in-out property <float> corner-value;
    in property <string> status;
    callback start-stroke(float, float);
    callback move-stroke(float, float);
    callback finish-stroke(float, float, int, int, float, string);
    callback adjustments(bool, float);
    callback undo();
    callback redo();
    callback copy();
    callback save();
    callback close-editor();
    callback pin();
    callback recognize();
    callback scan-code();

    title: root.browse ? @tr("Clippy Image Viewer") : @tr("Clippy Image Editor");
    heading: root.browse ? @tr("Image viewer") : @tr("Image Editor");
    heading-subtitle: root.browse ? "" + root.picture.width + " × " + root.picture.height + " · PNG" : "";
    heading-icon: root.browse ? "M3 4h18v16H3Z M3 16l6-5 4 4 4-2 4 3 M15 8h1" : "";
    dismiss-window => { root.close-editor(); }
    preferred-width: root.browse ? 1000px : 850px;
    preferred-height: root.browse ? 720px : 610px;
    min-width: root.browse ? 420px : 540px;
    min-height: 380px;

    if root.browse: ViewerPane {
        picture: root.picture;
        tools: root.tools;
        text-tool-index: root.text-tool-index;
        busy: root.busy;
        can-undo: root.can-undo;
        can-redo: root.can-redo;
        output-ready: root.output-ready;
        status: root.status;
        start-stroke(x, y) => { root.start-stroke(x, y); }
        move-stroke(x, y) => { root.move-stroke(x, y); }
        finish-stroke(x, y, tool, shade, stroke, text) => { root.finish-stroke(x, y, tool, shade, stroke, text); }
        undo => { root.undo(); }
        redo => { root.redo(); }
        copy => { root.copy(); }
        save => { root.save(); }
        recognize => { root.recognize(); }
        scan-code => { root.scan-code(); }
        pin => { root.pin(); }
    }

    if !root.browse: VerticalBox {
        padding: 12px;
        spacing: 8px;
        vertical-stretch: 1;
        HorizontalLayout {
            spacing: 8px;
            tool := ComboBox { model: root.tools; current-index: 2; enabled: !root.busy; }
            shade := ComboBox { model: [@tr("Red"), @tr("Orange"), @tr("Green"), @tr("Blue"), @tr("White"), @tr("Black")]; current-index: 0; enabled: !root.busy; }
            Text { text: @tr("Width"); vertical-alignment: center; color: ClippyTheme.foreground; }
            stroke := Slider { minimum: 1; maximum: 24; value: 3; min-width: 72px; enabled: !root.busy; }
            Button { text: @tr("Undo"); enabled: root.can-undo && !root.busy; clicked => { root.undo(); } }
            Button { text: @tr("Redo"); enabled: root.can-redo && !root.busy; clicked => { root.redo(); } }
        }
        entry := LineEdit {
            placeholder-text: @tr("Text to place on the image");
            enabled: !root.busy;
            visible: tool.current-index == root.text-tool-index;
            height: self.visible ? self.preferred-height : 0;
        }
        canvas := Rectangle {
            background: #252932;
            border-radius: 6px;
            vertical-stretch: 1;
            Image {
                source: root.picture;
                width: min(parent.width, parent.height * root.aspect);
                height: self.width / root.aspect;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: fill;
                TouchArea {
                    enabled: !root.busy;
                    mouse-cursor: crosshair;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left {
                            if event.kind == PointerEventKind.down {
                                root.start-stroke(self.mouse-x / self.width, self.mouse-y / self.height);
                            } else if event.kind == PointerEventKind.up {
                                root.finish-stroke(self.mouse-x / self.width, self.mouse-y / self.height,
                                    tool.current-index, shade.current-index, stroke.value, entry.text);
                            }
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.move-stroke(self.mouse-x / self.width, self.mouse-y / self.height);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            gray := CheckBox {
                text: @tr("Grayscale");
                checked <=> root.grayscale-value;
                enabled: !root.busy;
                toggled => { root.adjustments(self.checked, radius.value); }
            }
            Text { text: @tr("Corners"); vertical-alignment: center; color: ClippyTheme.foreground; }
            radius := Slider {
                minimum: 0; maximum: 120; value <=> root.corner-value; min-width: 60px;
                enabled: !root.busy;
                released => { root.adjustments(gray.checked, self.value); }
            }
            Button { text: @tr("Copy"); width: 90px; height: 34px; enabled: !root.busy && root.output-ready; clicked => { root.copy(); } }
            Button { text: @tr("Save PNG"); width: 90px; enabled: !root.busy && root.output-ready; clicked => { root.save(); } }
            Button { text: @tr("Close"); width: 90px; enabled: !root.busy; clicked => { root.close-editor(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.status; color: ClippyTheme.muted; wrap: word-wrap; min-height: 18px; }
            Button { text: @tr("OCR"); height: 28px; enabled: !root.busy && root.output-ready; clicked => { root.recognize(); } }
            Button { text: @tr("Scan code"); height: 28px; enabled: !root.busy && root.output-ready; clicked => { root.scan-code(); } }
            Button { text: @tr("Pin to desktop"); height: 28px; enabled: !root.busy && root.output-ready; clicked => { root.pin(); } }
        }
    }
}
