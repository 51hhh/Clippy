import { LineEdit } from "std-widgets.slint";
import { ClippyIcon, SurfaceButton } from "theme.slint";

export enum CaptureAction { copy, save, edit, longshot, record }
export enum CaptureTool { select, rectangle, ellipse, line, arrow, highlight, pen, text, mosaic }
export struct CaptureMark { x0: float, y0: float, x1: float, y1: float, tool: CaptureTool, ink: color, stroke: float }
export struct CapturePoint { x: float, y: float }
export struct CaptureMosaic {
    source: image, x: float, y: float, width: float, height: float, tiled-width: float, tiled-height: float, work-pixels: int
}
export struct CaptureAnnotation { geometry: CaptureMark, points: [CapturePoint], path: string, text: string, mosaic: CaptureMosaic }
export struct CaptureWindowTarget { left: int, top: int, right: int, bottom: int, title: string }
export struct DesktopPreview {
    active: bool, dragging: bool, controls: bool, left: float, top: float, right: float, bottom: float,
    edge-left: bool, edge-top: bool, edge-right: bool, edge-bottom: bool, pixel-width: int, pixel-height: int,
}
struct ToolButton { label: string, tool: CaptureTool, drawing: string }
struct CaptureCommand { label: string, action: CaptureAction, drawing: string }
struct OverlayInk { ink: color, label: string }
struct SelectionBounds { left: length, top: length, right: length, bottom: length }
enum SelectionGesture { select, move, resize }

component OverlayButton inherits SurfaceButton {
    in property <string> drawing;
    in property <color> ink: #e5e7eb;
    caption: "";
    border-radius: 5px;
    background: self.selected ? #355986 : self.hovered ? #ffffff20 : transparent;
    border-color: #80b6fc;
    ClippyIcon {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        drawing: root.drawing; ink: root.enabled ? root.ink : #7e8490;
    }
}

component MarkVisual inherits Rectangle {
    in property <CaptureMark> mark;
    in property <length> pixel-scale;
    in property <string> path;
    in property <string> caption;
    private property <length> weight: root.mark.stroke * root.pixel-scale;
    private property <length> first-x: root.mark.x0 * root.width;
    private property <length> first-y: root.mark.y0 * root.height;
    private property <length> last-x: root.mark.x1 * root.width;
    private property <length> last-y: root.mark.y1 * root.height;
    private property <length> left: min(root.first-x, root.last-x);
    private property <length> top: min(root.first-y, root.last-y);
    private property <length> size-x: abs(root.first-x - root.last-x);
    private property <length> size-y: abs(root.first-y - root.last-y);
    private property <float> dx: (root.last-x - root.first-x) / 1px;
    private property <float> dy: (root.last-y - root.first-y) / 1px;
    private property <float> direction-x: root.dx / max(1.0, sqrt(root.dx * root.dx + root.dy * root.dy));
    private property <float> direction-y: root.dy / max(1.0, sqrt(root.dx * root.dx + root.dy * root.dy));

    if root.mark.tool == CaptureTool.rectangle || root.mark.tool == CaptureTool.highlight: Rectangle {
        x: root.left; y: root.top; width: root.size-x; height: root.size-y;
        border-width: root.mark.tool == CaptureTool.rectangle ? root.weight : 0px;
        border-color: root.mark.ink;
        background: root.mark.tool == CaptureTool.highlight ? root.mark.ink.with-alpha(0.3) : transparent;
    }
    if root.mark.tool == CaptureTool.ellipse && root.size-x > 0px && root.size-y > 0px: Path {
        width: parent.width; height: parent.height;
        fit: preserve;
        stroke: root.mark.ink; stroke-width: root.weight;
        commands: "M " + (root.left / 1px) + " " + ((root.top + root.size-y / 2) / 1px)
            + " a " + (root.size-x / 2px) + " " + (root.size-y / 2px) + " 0 1 1 " + (root.size-x / 1px) + " 0"
            + " a " + (root.size-x / 2px) + " " + (root.size-y / 2px) + " 0 1 1 " + (-root.size-x / 1px) + " 0";
    }
    if root.mark.tool == CaptureTool.line || root.mark.tool == CaptureTool.arrow: Path {
        width: parent.width; height: parent.height;
        fit: preserve;
        stroke: root.mark.ink; stroke-width: root.weight; stroke-line-cap: round; stroke-line-join: round;
        commands: "M " + (root.first-x / 1px) + " " + (root.first-y / 1px) + " L " + (root.last-x / 1px) + " " + (root.last-y / 1px)
            + (root.mark.tool == CaptureTool.arrow ?
                " m " + (-root.direction-x * 10 - root.direction-y * 4) + " " + (-root.direction-y * 10 + root.direction-x * 4)
                + " L " + (root.last-x / 1px) + " " + (root.last-y / 1px)
                + " l " + (-root.direction-x * 10 + root.direction-y * 4) + " " + (-root.direction-y * 10 - root.direction-x * 4) : "");
    }
    if root.mark.tool == CaptureTool.pen && root.path != "": Path {
        width: parent.width; height: parent.height;
        fit: preserve;
        stroke: root.mark.ink; stroke-width: root.weight; stroke-line-cap: round; stroke-line-join: round;
        commands: root.path;
    }
    if root.mark.tool == CaptureTool.text: Text {
        x: root.first-x; y: root.first-y;
        width: root.width - self.x; height: self.preferred-height;
        text: root.caption; color: root.mark.ink;
        font-family: "Noto Sans CJK SC"; font-weight: 500;
        font-size: max(14.0, root.mark.stroke * 4.0) * root.pixel-scale;
        overflow: clip;
    }
    if root.mark.tool == CaptureTool.mosaic: Rectangle {
        x: root.left; y: root.top; width: root.size-x; height: root.size-y;
        border-width: 1px; border-color: #e5e7eb;
    }
}

export component CaptureWindow inherits Window {
    in property <image> frame;
    in property <int> source-width;
    in property <int> source-height;
    in property <[CaptureWindowTarget]> window-targets;
    in property <bool> desktop-enabled;
    in property <bool> owns-selection: true;
    in property <DesktopPreview> desktop-preview;
    out property <int> snapped-window: -1;
    in property <[CaptureAnnotation]> marks;
    in property <[CaptureAnnotation]> undone-marks;
    in property <string> pen-path;
    in property <bool> mosaic-pending;
    in-out property <string> annotation-error;
    callback cancel();
    callback confirm(CaptureAction, float, float, float, float);
    callback begin-desktop-selection();
    callback update-desktop-selection(float, float, float, float, bool);
    callback reset-desktop-selection();
    callback confirm-desktop(CaptureAction);
    callback add-mark(CaptureAnnotation) -> bool;
    callback undo-mark();
    callback redo-mark();
    callback clear-marks();
    callback sample-pen(bool, float, float, float, float);
    callback finish-pen(CaptureMark);
    callback render-mosaic(CaptureMark, float, float, float, float);
    pure callback window-at(float, float) -> int;

    private property <length> left;
    private property <length> top;
    private property <length> right;
    private property <length> bottom;
    private property <length> selection-width: root.right - root.left;
    private property <length> selection-height: root.bottom - root.top;
    private property <bool> selected: root.owns-selection && root.selection-width >= 1px && root.selection-height >= 1px;
    private property <bool> ready: root.selected && !drag.pressed && !root.desktop-preview.active;
    private property <CaptureTool> active-tool;
    private property <bool> marking: root.owns-selection && root.active-tool != CaptureTool.select;
    private property <bool> covers-output: root.selection-width >= root.width - 1px
        && root.selection-height >= root.height - 1px;
    private property <int> pressed-window: -1;
    private property <int> hovered-window: drag.has-hover && !drag.pressed && !root.marking
        && !root.desktop-preview.active && !root.mosaic-pending && !root.near-selection(drag.mouse-x, drag.mouse-y)
        ? root.hit-window(drag.mouse-x, drag.mouse-y) : -1;
    private property <SelectionBounds> hover-bounds: root.hovered-window >= 0
        ? root.window-bounds(root.window-targets[root.hovered-window])
        : { left: 0px, top: 0px, right: 0px, bottom: 0px };
    private property <SelectionBounds> desktop-bounds: {
        left: root.desktop-preview.left * root.width, right: root.desktop-preview.right * root.width,
        top: root.desktop-preview.top * root.height, bottom: root.desktop-preview.bottom * root.height,
    };
    private property <bool> desktop-visible: root.desktop-preview.right > root.desktop-preview.left
        && root.desktop-preview.bottom > root.desktop-preview.top;
    private property <bool> desktop-valid: root.desktop-preview.pixel-width > 0;
    private property <SelectionBounds> revealed: root.desktop-preview.active ? root.desktop-bounds
        : root.selected ? { left: root.left, top: root.top, right: root.right, bottom: root.bottom } : root.hover-bounds;
    private property <bool> reveals-region: root.desktop-preview.active
        ? root.desktop-visible : root.selected || root.hovered-window >= 0;
    private property <color> active-ink: #ff3b30;
    private property <float> stroke: 3.0;
    private property <SelectionGesture> gesture;
    private property <SelectionBounds> drag-start;
    private property <int> resize-x;
    private property <int> resize-y;
    private property <bool> moved-selection;
    private property <CaptureMark> draft-mark;
    private property <bool> entering-text;
    private property <string> draft-text;
    private property <CaptureMark> pending-mosaic;
    private property <color> shade: #00000057;
    private property <length> pixel-scale: root.width / max(1, root.source-width);
    private property <length> gap: 8px;
    private property <length> toolbar-width: min(560px, root.width - 2 * root.gap);
    private property <length> toolbar-height: 76px;
    private property <length> tool-width: min(32px, (root.toolbar-width - 24px) / (root.tools.length + root.commands.length));
    private property <bool> toolbar-below: root.bottom + root.toolbar-height + 2 * root.gap <= root.height;
    private property <length> toolbar-y: root.toolbar-below
        ? root.bottom + root.gap : max(root.gap, root.top - root.toolbar-height - root.gap);
    private property <length> chip-height: 22px;
    private property <length> chip-y: !root.ready || root.toolbar-below
        ? max(root.gap, root.top - root.chip-height - 4px)
        : root.toolbar-y >= root.gap + root.chip-height + 4px
            ? root.toolbar-y - root.chip-height - 4px
            : min(root.height - root.chip-height - root.gap, root.toolbar-y + root.toolbar-height + 4px);
    private property <[ToolButton]> tools: [
        { label: "Select", tool: CaptureTool.select, drawing: "M4 8h12v12M8 4v12h12" },
        { label: "Rectangle", tool: CaptureTool.rectangle, drawing: "M3 5h18v14H3Z" },
        { label: "Ellipse", tool: CaptureTool.ellipse, drawing: "M12 3a9 9 0 1 1 0 18 9 9 0 1 1 0-18" },
        { label: "Line", tool: CaptureTool.line, drawing: "M4 12h16" },
        { label: "Arrow", tool: CaptureTool.arrow, drawing: "M5 19 19 5M8 5h11v11" },
        { label: "Highlight", tool: CaptureTool.highlight, drawing: "M4 14 15 3l5 5-11 11-5 1Z M4 14l5 5M4 22h16" },
        { label: "Pen", tool: CaptureTool.pen, drawing: "M4 15 15 4l5 5L9 20H4Z M12 7l5 5" },
        { label: "Text", tool: CaptureTool.text, drawing: "M4 6V4h16v2M12 4v16m-4 0h8" },
        { label: "Mosaic", tool: CaptureTool.mosaic, drawing: "M4 4h16v16H4Z M12 4v16M4 12h16M5 5l6 6m2 2 6 6" },
    ];
    private property <[CaptureCommand]> commands: [
        { label: "Edit image", action: CaptureAction.edit, drawing: "M4 19l1-5L17 2l5 5L10 19Z M14 5l5 5 M3 22h18" },
        { label: "Scrolling capture", action: CaptureAction.longshot, drawing: "M4 4h16v16H4Z M8 8h8 M8 12h5 M14 16h4 M16 14v4" },
        { label: "Record", action: CaptureAction.record, drawing: "M3 5h13v14H3Z M16 10l5-4v12l-5-4Z" },
    ];
    private property <[OverlayInk]> inks: [
        { ink: #ff3b30, label: "Red" }, { ink: #ffcf36, label: "Yellow" }, { ink: #38c875, label: "Green" },
        { ink: #0a84ff, label: "Blue" }, { ink: #ffffff, label: "White" }, { ink: #17191f, label: "Black" },
    ];
    private property <string> cancel-icon: "M5 5l14 14 M19 5L5 19";
    private property <string> save-icon: "M4 3h13l4 4v14H3V3Z M7 3v7h10V3 M7 21v-7h10v7";
    private property <string> copy-icon: "M5 12l4 4L19 6";

    title: "Clippy Screenshot";
    no-frame: true;
    background: #161616;
    forward-focus: keys;

    pure function near-selection(x: length, y: length) -> bool {
        let margin = 7px;
        return !root.desktop-preview.active && root.selected && x >= root.left - margin && x <= root.right + margin
            && y >= root.top - margin && y <= root.bottom + margin;
    }

    pure function hit-window(x: length, y: length) -> int {
        return root.window-targets.length == 0 ? -1
            : root.window-at(x / root.width * root.source-width, y / root.height * root.source-height);
    }

    pure function window-bounds(target: CaptureWindowTarget) -> SelectionBounds {
        return {
            left: target.left / root.source-width * root.width,
            top: target.top / root.source-height * root.height,
            right: target.right / root.source-width * root.width,
            bottom: target.bottom / root.source-height * root.height,
        };
    }

    function set-bounds(bounds: SelectionBounds) {
        root.left = bounds.left;
        root.top = bounds.top;
        root.right = bounds.right;
        root.bottom = bounds.bottom;
    }

    function drag-bounds(x0: length, y0: length, x1: length, y1: length) {
        root.set-bounds({
            left: clamp(min(x0, x1), 0px, root.width),
            top: clamp(min(y0, y1), 0px, root.height),
            right: clamp(max(x0, x1), 0px, root.width),
            bottom: clamp(max(y0, y1), 0px, root.height),
        });
    }

    function update-drag(x0: length, y0: length, x1: length, y1: length, released: bool) {
        root.drag-bounds(x0, y0, x1, y1);
        if root.desktop-enabled {
            root.update-desktop-selection(x0 / root.width, y0 / root.height, x1 / root.width, y1 / root.height, released);
        }
    }

    function commit(action: CaptureAction) {
        if !root.mosaic-pending && root.finish-caption() {
            root.confirm(action, root.left / root.width, root.top / root.height, root.right / root.width, root.bottom / root.height);
        }
    }

    function dismiss-caption() {
        root.entering-text = false;
        root.draft-text = "";
        root.annotation-error = "";
        keys.focus();
    }

    function finish-caption() -> bool {
        if root.entering-text {
            if !root.add-mark({ geometry: root.draft-mark, text: root.draft-text }) {
                caption-entry.focus();
                return false;
            }
            root.dismiss-caption();
        }
        return true;
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: fill;
    }

    if !root.reveals-region: Rectangle { x: 0px; y: 0px; width: root.width; height: root.height; background: #00000061; }
    if root.reveals-region: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.revealed.top; background: root.shade;
    }
    if root.reveals-region: Rectangle {
        x: 0px; y: root.revealed.bottom; width: root.width; height: root.height - root.revealed.bottom; background: root.shade;
    }
    if root.reveals-region: Rectangle {
        x: 0px; y: root.revealed.top; width: root.revealed.left;
        height: root.revealed.bottom - root.revealed.top; background: root.shade;
    }
    if root.reveals-region: Rectangle {
        x: root.revealed.right; y: root.revealed.top; width: root.width - root.revealed.right;
        height: root.revealed.bottom - root.revealed.top; background: root.shade;
    }
    if root.hovered-window >= 0: Rectangle {
        x: root.hover-bounds.left;
        y: root.hover-bounds.top;
        width: root.hover-bounds.right - self.x;
        height: root.hover-bounds.bottom - self.y;
        border-width: 2px;
        border-color: #0a84ff;
        background: transparent;
    }
    if root.desktop-preview.active && root.desktop-visible: Rectangle {
        x: root.desktop-bounds.left;
        y: root.desktop-bounds.top;
        width: root.desktop-bounds.right - self.x;
        height: root.desktop-bounds.bottom - self.y;
        Path {
            width: parent.width; height: parent.height;
            fit: preserve;
            stroke: #0a84ff; stroke-width: 2px; stroke-dash-array: [5px, 4px];
            property <float> end-x: max(1.0, self.width / 1px - 1);
            property <float> end-y: max(1.0, self.height / 1px - 1);
            commands: (root.desktop-preview.edge-top ? "M 0 1 H " + (self.width / 1px) + " " : "")
                + (root.desktop-preview.edge-bottom ? "M 0 " + end-y + " H " + (self.width / 1px) + " " : "")
                + (root.desktop-preview.edge-left ? "M 1 0 V " + (self.height / 1px) + " " : "")
                + (root.desktop-preview.edge-right ? "M " + end-x + " 0 V " + (self.height / 1px) : "");
        }
    }

    drag := TouchArea {
        enabled: !root.marking && !root.mosaic-pending;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                let point-x = self.mouse-x;
                let point-y = self.mouse-y;
                let margin = 7px;
                let near = root.near-selection(point-x, point-y);
                root.resize-x = abs(point-x - root.left) <= margin ? -1 : abs(point-x - root.right) <= margin ? 1 : 0;
                root.resize-y = abs(point-y - root.top) <= margin ? -1 : abs(point-y - root.bottom) <= margin ? 1 : 0;
                root.annotation-error = "";
                root.gesture = near && (root.resize-x != 0 || root.resize-y != 0) ? SelectionGesture.resize
                    : near && !root.covers-output ? SelectionGesture.move : SelectionGesture.select;
                root.drag-start = { left: root.left, top: root.top, right: root.right, bottom: root.bottom };
                root.moved-selection = false;
                if root.gesture == SelectionGesture.select {
                    root.pressed-window = root.hit-window(point-x, point-y);
                    root.snapped-window = -1;
                    if root.desktop-enabled {
                        root.begin-desktop-selection();
                        root.active-tool = CaptureTool.select;
                        if root.entering-text {
                            root.dismiss-caption();
                        }
                    }
                    root.clear-marks();
                    root.drag-bounds(point-x, point-y, point-x, point-y);
                }
                keys.focus();
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left
                && root.gesture == SelectionGesture.select {
                let dx = (self.mouse-x - self.pressed-x) / 1px;
                let dy = (self.mouse-y - self.pressed-y) / 1px;
                if dx * dx + dy * dy < 16.0 {
                    if root.desktop-enabled {
                        root.reset-desktop-selection();
                    }
                    root.snapped-window = root.pressed-window;
                    root.set-bounds(root.snapped-window >= 0
                        ? root.window-bounds(root.window-targets[root.snapped-window])
                        : { left: 0px, top: 0px, right: root.width, bottom: root.height });
                } else {
                    root.update-drag(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y, true);
                }
            } else if event.kind == PointerEventKind.cancel && root.desktop-preview.dragging {
                root.reset-desktop-selection();
            }
        }
        moved => {
            if self.pressed && root.gesture == SelectionGesture.select {
                root.update-drag(self.pressed-x, self.pressed-y, self.mouse-x, self.mouse-y, false);
            } else if self.pressed && (self.mouse-x != self.pressed-x || self.mouse-y != self.pressed-y) {
                if !root.moved-selection {
                    root.clear-marks();
                    root.snapped-window = -1;
                    root.moved-selection = true;
                }
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                if root.gesture == SelectionGesture.move {
                    let shift-x = clamp(dx, -root.drag-start.left, root.width - root.drag-start.right);
                    let shift-y = clamp(dy, -root.drag-start.top, root.height - root.drag-start.bottom);
                    root.left = root.drag-start.left + shift-x;
                    root.top = root.drag-start.top + shift-y;
                    root.right = root.drag-start.right + shift-x;
                    root.bottom = root.drag-start.bottom + shift-y;
                } else {
                    if root.resize-x < 0 { root.left = clamp(root.drag-start.left + dx, 0px, root.drag-start.right - 1px); }
                    if root.resize-x > 0 { root.right = clamp(root.drag-start.right + dx, root.drag-start.left + 1px, root.width); }
                    if root.resize-y < 0 { root.top = clamp(root.drag-start.top + dy, 0px, root.drag-start.bottom - 1px); }
                    if root.resize-y > 0 { root.bottom = clamp(root.drag-start.bottom + dy, root.drag-start.top + 1px, root.height); }
                }
            }
        }
    }

    if root.hovered-window >= 0 && root.window-targets[root.hovered-window].title != "": Rectangle {
        x: clamp(root.hover-bounds.left, root.gap, root.width - self.width - root.gap);
        y: max(root.gap, root.hover-bounds.top - root.chip-height - 4px);
        width: min(title-text.preferred-width + 14px, 280px, root.width - 2 * root.gap);
        height: root.chip-height;
        border-radius: 5px;
        background: #202124;
        title-text := Text {
            x: 7px; y: 0px; width: parent.width - 14px; height: parent.height;
            text: root.window-targets[root.hovered-window].title;
            font-size: 12px; color: #ffffff; vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.selected && !root.desktop-preview.active: Rectangle {
        x: root.left;
        y: root.top;
        width: root.right - root.left;
        height: root.bottom - root.top;
        clip: true;
        for item in root.marks: Rectangle {
            width: parent.width; height: parent.height;
            if item.geometry.tool == CaptureTool.mosaic: Rectangle {
                x: item.mosaic.x * parent.width; y: item.mosaic.y * parent.height;
                width: item.mosaic.width * parent.width; height: item.mosaic.height * parent.height;
                clip: true;
                Image {
                    x: 0px; y: 0px;
                    width: item.mosaic.tiled-width * root.selection-width;
                    height: item.mosaic.tiled-height * root.selection-height;
                    source: item.mosaic.source; image-fit: fill; image-rendering: pixelated;
                }
            }
        }
        Path {
            width: parent.width;
            height: parent.height;
            stroke: #0a84ff;
            stroke-width: 2px;
            stroke-dash-array: [5px, 4px];
            commands: "M1 1 H " + (self.width / 1px - 1) + " V " + (self.height / 1px - 1) + " H1 Z";
        }
        for item in root.marks: MarkVisual {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            visible: item.geometry.tool != CaptureTool.mosaic;
            mark: item.geometry; pixel-scale: root.pixel-scale; path: item.path; caption: item.text;
        }
        mark-drag := TouchArea {
            enabled: root.marking && root.marks.length < 64 && !root.entering-text && !root.mosaic-pending;
            mouse-cursor: root.active-tool == CaptureTool.text ? text : crosshair;
            property <float> cursor-x: clamp(self.mouse-x / self.width, 0.0, 1.0);
            property <float> cursor-y: clamp(self.mouse-y / self.height, 0.0, 1.0);
            property <CaptureMark> current: {
                x0: clamp(self.pressed-x / self.width, 0.0, 1.0),
                y0: clamp(self.pressed-y / self.height, 0.0, 1.0),
                x1: self.cursor-x, y1: self.cursor-y,
                tool: root.active-tool, ink: root.active-ink, stroke: root.stroke,
            };
            function sample(begin: bool) {
                root.sample-pen(begin, self.cursor-x, self.cursor-y, self.width / 1px, self.height / 1px);
            }
            moved => {
                if self.pressed && root.active-tool == CaptureTool.pen {
                    self.sample(false);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.annotation-error = "";
                    if root.active-tool == CaptureTool.pen {
                        self.sample(true);
                    }
                    keys.focus();
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    if root.active-tool == CaptureTool.pen {
                        self.sample(false);
                        root.finish-pen(self.current);
                    } else if root.active-tool == CaptureTool.text {
                        root.draft-mark = self.current;
                        root.entering-text = true;
                        caption-entry.focus();
                    } else {
                        let dx = abs(self.current.x1 - self.current.x0) * self.width;
                        let dy = abs(self.current.y1 - self.current.y0) * self.height;
                        let linear = root.active-tool == CaptureTool.line || root.active-tool == CaptureTool.arrow;
                        if linear ? max(dx, dy) >= 2px : min(dx, dy) >= 2px {
                            if root.active-tool == CaptureTool.mosaic {
                                root.pending-mosaic = self.current;
                                root.render-mosaic(self.current, root.left / root.width, root.top / root.height,
                                    root.right / root.width, root.bottom / root.height);
                            } else {
                                root.add-mark({ geometry: self.current });
                            }
                        }
                    }
                }
            }
        }
        if (mark-drag.pressed && root.active-tool != CaptureTool.text) || root.mosaic-pending: MarkVisual {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            mark: root.mosaic-pending ? root.pending-mosaic : mark-drag.current;
            pixel-scale: root.pixel-scale; path: root.pen-path;
        }
    }

    if root.ready && !root.marking: Rectangle {
        x: root.left;
        y: root.top;
        width: root.right - root.left;
        height: root.bottom - root.top;
        for handle in [{ x: 0.0, y: 0.0 }, { x: 0.5, y: 0.0 }, { x: 1.0, y: 0.0 },
                       { x: 0.0, y: 0.5 }, { x: 1.0, y: 0.5 },
                       { x: 0.0, y: 1.0 }, { x: 0.5, y: 1.0 }, { x: 1.0, y: 1.0 }]: Rectangle {
            x: handle.x * parent.width - 5px;
            y: handle.y * parent.height - 5px;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            border-width: 1px;
            border-color: #ffffff;
            background: #2f8cff;
        }
    }

    if root.selected && !root.desktop-preview.active: Rectangle {
        x: clamp(root.left, root.gap, root.width - self.width - root.gap);
        y: root.chip-y;
        width: dimensions.preferred-width + 14px;
        height: root.chip-height;
        border-radius: 5px;
        background: #202124;
        dimensions := Text {
            text: root.snapped-window >= 0
                ? "" + (root.window-targets[root.snapped-window].right - root.window-targets[root.snapped-window].left)
                    + " × " + (root.window-targets[root.snapped-window].bottom - root.window-targets[root.snapped-window].top)
                : "" + (ceil(root.right / root.width * root.source-width) - floor(root.left / root.width * root.source-width))
                    + " × " + (ceil(root.bottom / root.height * root.source-height) - floor(root.top / root.height * root.source-height));
            font-size: 12px;
            color: #ffffff;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if !root.selected && !root.desktop-preview.active && !drag.pressed && root.hovered-window < 0: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 16px;
        width: 260px;
        height: 44px;
        border-radius: 8px;
        background: #202124;
        HorizontalLayout {
            padding: 8px;
            spacing: 6px;
            Text {
                text: root.window-targets.length > 0 ? "Click a window or drag an area" : "Drag to select an area";
                color: #ffffff;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
                horizontal-stretch: 1;
            }
            OverlayButton { label: "Cancel"; width: 32px; drawing: root.cancel-icon; clicked => { root.cancel(); } }
        }
    }

    if root.ready: Rectangle {
        x: clamp(root.right - self.width, root.gap, root.width - self.width - root.gap);
        y: root.toolbar-y;
        width: root.toolbar-width;
        height: root.toolbar-height;
        border-radius: 8px;
        background: #202124;
        TouchArea { }
        for tool[index] in root.tools: OverlayButton {
            x: 6px + index * root.tool-width; y: 4px; width: root.tool-width; height: 30px;
            label: tool.label; drawing: tool.drawing;
            enabled: !root.mosaic-pending;
            selected: root.active-tool == tool.tool;
            clicked => {
                if root.finish-caption() {
                    root.active-tool = tool.tool;
                    keys.focus();
                }
            }
        }
        Rectangle { x: 8px + root.tools.length * root.tool-width; y: 8px; width: 1px; height: 22px; background: #444956; }
        for command[index] in root.commands: OverlayButton {
            x: 15px + (root.tools.length + index) * root.tool-width; y: 4px; width: root.tool-width; height: 30px;
            label: command.label; drawing: command.drawing;
            enabled: !root.mosaic-pending;
            clicked => { root.commit(command.action); }
        }
        Rectangle { x: 8px; y: 37px; width: parent.width - 16px; height: 1px; background: #3d4049; }
        for sample[index] in root.inks: SurfaceButton {
            x: 7px + index * 19px; y: 45px; width: 19px; min-width: 19px; height: 24px;
            label: sample.label; caption: ""; background: transparent;
            enabled: !root.entering-text && !root.mosaic-pending;
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 15px; height: 15px; border-radius: 8px; border-color: #b7bdca;
                border-width: 1px; background: sample.ink;
            }
            if root.active-ink == sample.ink: Rectangle {
                x: 0.5px; y: 3px; width: 18px; height: 18px; border-radius: 9px;
                border-color: #2f8cff; border-width: 1px;
            }
            clicked => { root.active-ink = sample.ink; keys.focus(); }
        }
        if root.toolbar-width >= 380px: Text {
            x: 126px; y: 45px; width: 28px; height: 24px;
            text: "Size"; font-size: 11px; color: #e5e7eb; vertical-alignment: center;
        }
        if root.toolbar-width >= 380px: Rectangle {
            x: 157px; y: 45px; width: min(100px, history-actions.x - self.x - 8px); height: 24px;
            accessible-role: slider;
            accessible-label: "Stroke width";
            accessible-value: "" + round(root.stroke);
            Rectangle { width: parent.width; height: 4px; border-radius: 2px; background: #535967; }
            Rectangle { x: 0px; width: (root.stroke - 1) / 11 * parent.width; height: 4px; border-radius: 2px; background: #2f8cff; }
            Rectangle { x: (root.stroke - 1) / 11 * parent.width - 5px; width: 10px; height: 10px; border-radius: 5px; background: #ffffff; }
            TouchArea {
                enabled: !root.entering-text && !root.mosaic-pending;
                mouse-cursor: pointer;
                clicked => { root.stroke = clamp(round(1 + 11 * self.mouse-x / self.width), 1, 12); keys.focus(); }
                moved => { if self.pressed { root.stroke = clamp(round(1 + 11 * self.mouse-x / self.width), 1, 12); } }
            }
        }
        history-actions := HorizontalLayout {
            x: parent.width - 6px - 6 * root.tool-width; y: 42px; width: 6 * root.tool-width; height: 30px;
            OverlayButton {
                label: "Undo"; drawing: "M9 5l-6 6 6 6 M3 11h12a5 5 0 0 1 5 5v3";
                width: root.tool-width; enabled: root.marks.length > 0 && !root.entering-text && !root.mosaic-pending;
                clicked => { root.undo-mark(); keys.focus(); }
            }
            OverlayButton {
                label: "Redo"; drawing: "M15 5l6 6-6 6 M21 11H9a5 5 0 0 0-5 5v3";
                width: root.tool-width; enabled: root.undone-marks.length > 0 && !root.entering-text && !root.mosaic-pending;
                clicked => { root.redo-mark(); keys.focus(); }
            }
            OverlayButton {
                label: "Clear marks"; drawing: "M4 6h16m-6 0V3h-4v3M6 6l1 15h10l1-15M10 10v7m4-7v7";
                width: root.tool-width;
                enabled: (root.marks.length > 0 || root.undone-marks.length > 0) && !root.entering-text && !root.mosaic-pending;
                clicked => { root.clear-marks(); keys.focus(); }
            }
            OverlayButton {
                label: "Save PNG"; drawing: root.save-icon;
                width: root.tool-width; enabled: !root.mosaic-pending;
                clicked => { root.commit(CaptureAction.save); }
            }
            OverlayButton {
                label: "Copy"; drawing: root.copy-icon; ink: #6ee7a8;
                width: root.tool-width; enabled: !root.mosaic-pending;
                clicked => { root.commit(CaptureAction.copy); }
            }
            OverlayButton { label: "Cancel"; drawing: root.cancel-icon; width: root.tool-width; clicked => { root.cancel(); } }
        }
    }

    if root.desktop-preview.controls: Rectangle {
        x: clamp(root.desktop-bounds.right - self.width, root.gap, root.width - self.width - root.gap);
        y: root.desktop-bounds.bottom + self.height + 2 * root.gap <= root.height
            ? root.desktop-bounds.bottom + root.gap : max(root.gap, root.desktop-bounds.top - self.height - root.gap);
        width: 144px; height: 46px; border-radius: 8px; background: #202124;
        TouchArea { }
        HorizontalLayout {
            padding: 8px;
            OverlayButton {
                label: "Edit image"; drawing: root.commands[0].drawing; enabled: root.desktop-valid;
                clicked => { root.confirm-desktop(CaptureAction.edit); }
            }
            OverlayButton {
                label: "Save PNG"; drawing: root.save-icon; enabled: root.desktop-valid;
                clicked => { root.confirm-desktop(CaptureAction.save); }
            }
            OverlayButton {
                label: "Copy"; drawing: root.copy-icon; ink: #6ee7a8; enabled: root.desktop-valid;
                clicked => { root.confirm-desktop(CaptureAction.copy); }
            }
            OverlayButton { label: "Cancel"; drawing: root.cancel-icon; clicked => { root.cancel(); } }
        }
        Rectangle {
            x: clamp(root.desktop-bounds.left - parent.x, root.gap - parent.x,
                root.width - parent.x - self.width - root.gap);
            y: parent.y >= root.gap + self.height + 4px ? -self.height - 4px : parent.height + 4px;
            width: desktop-size.preferred-width + 14px; height: root.chip-height;
            border-radius: 5px; background: #202124;
            desktop-size := Text {
                text: root.desktop-valid ? "" + root.desktop-preview.pixel-width + " × " + root.desktop-preview.pixel-height
                    : "Selection is too large";
                font-size: 12px; color: white;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }

    caption-entry := FocusScope {
        visible: root.owns-selection && root.entering-text && !root.desktop-preview.active;
        x: clamp(root.left + root.draft-mark.x0 * root.selection-width, root.gap, root.width - self.width - root.gap);
        y: clamp(root.top + root.draft-mark.y0 * root.selection-height, root.gap, root.height - self.height - root.gap);
        width: min(260px, root.width - 2 * root.gap);
        height: 34px;
        forward-focus: caption-input;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss-caption();
                return accept;
            }
            reject
        }
        caption-input := LineEdit {
            width: parent.width; height: parent.height;
            text <=> root.draft-text;
            placeholder-text: "Annotation text";
            accepted => { root.finish-caption(); }
        }
    }
    if root.owns-selection && (root.mosaic-pending || root.annotation-error != ""): Rectangle {
        x: (root.width - self.width) / 2; y: root.gap;
        width: annotation-status.preferred-width + 20px; height: 28px;
        background: #202124; border-radius: 6px;
        annotation-status := Text {
            text: root.mosaic-pending ? "Applying mosaic…" : root.annotation-error;
            color: #ffffff; font-size: 12px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if root.desktop-preview.active && event.text == Key.Return {
                if root.desktop-valid {
                    root.confirm-desktop(CaptureAction.copy);
                }
                return accept;
            }
            if root.ready && event.text == Key.Return {
                root.commit(CaptureAction.copy);
                return accept;
            }
            if root.ready && !root.mosaic-pending && (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt {
                let z = event.text == "z" || event.text == "Z";
                if z && !event.modifiers.shift && root.marks.length > 0 {
                    root.undo-mark();
                    return accept;
                }
                let redo = (z && event.modifiers.shift) || event.text == "y";
                if redo && root.undone-marks.length > 0 {
                    root.redo-mark();
                    return accept;
                }
            }
            reject
        }
    }
}
