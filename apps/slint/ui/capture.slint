import { Button } from "std-widgets.slint";

export enum CaptureAction { copy, save, edit, longshot, record }
export struct CaptureMark { left: float, top: float, right: float, bottom: float }
struct CaptureCommand { label: string, action: CaptureAction }

export component CaptureWindow inherits Window {
    in property <image> frame;
    in property <int> source-width;
    in property <int> source-height;
    in property <[CaptureMark]> marks;
    callback cancel();
    callback confirm(CaptureAction, float, float, float, float);
    callback add-mark(CaptureMark);
    callback undo-mark();
    callback clear-marks();

    private property <length> left;
    private property <length> top;
    private property <length> right;
    private property <length> bottom;
    private property <bool> selected: right - left >= 1px && bottom - top >= 1px;
    private property <bool> ready: selected && !drag.pressed;
    private property <bool> marking;
    private property <length> mark-stroke: 3 * root.width / max(1, root.source-width);
    private property <length> gap: 8px;
    private property <length> toolbar-width: min(640px, root.width - 2 * root.gap);
    private property <length> toolbar-height: 44px;
    private property <length> button-width: (root.toolbar-width - 58px) / 8;
    private property <bool> toolbar-below: root.bottom + root.toolbar-height + 2 * root.gap <= root.height;
    private property <length> toolbar-y: root.toolbar-below
        ? root.bottom + root.gap : max(root.gap, root.top - root.toolbar-height - root.gap);
    private property <length> chip-height: 22px;
    private property <length> chip-y: !root.ready || root.toolbar-below
        ? max(root.gap, root.top - root.chip-height - 4px)
        : root.toolbar-y >= root.gap + root.chip-height + 4px
            ? root.toolbar-y - root.chip-height - 4px
            : min(root.height - root.chip-height - root.gap, root.toolbar-y + root.toolbar-height + 4px);
    private property <[CaptureCommand]> commands: [
        { label: "Copy", action: CaptureAction.copy },
        { label: "Save PNG", action: CaptureAction.save },
        { label: "Edit", action: CaptureAction.edit },
        { label: "Scroll", action: CaptureAction.longshot },
        { label: "Record", action: CaptureAction.record },
    ];

    title: "Clippy Screenshot";
    no-frame: true;
    background: #161616;
    forward-focus: keys;

    function commit(action: CaptureAction) {
        root.confirm(action, root.left / root.width, root.top / root.height, root.right / root.width, root.bottom / root.height);
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: fill;
    }

    drag := TouchArea {
        enabled: !root.marking;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.clear-marks();
                root.left = self.mouse-x;
                root.right = self.mouse-x;
                root.top = self.mouse-y;
                root.bottom = self.mouse-y;
                keys.focus();
            }
        }
        moved => {
            if self.pressed {
                root.left = clamp(min(self.pressed-x, self.mouse-x), 0px, root.width);
                root.top = clamp(min(self.pressed-y, self.mouse-y), 0px, root.height);
                root.right = clamp(max(self.pressed-x, self.mouse-x), 0px, root.width);
                root.bottom = clamp(max(self.pressed-y, self.mouse-y), 0px, root.height);
            }
        }
    }

    if root.selected: Rectangle {
        x: root.left;
        y: root.top;
        width: root.right - root.left;
        height: root.bottom - root.top;
        border-width: 2px;
        border-color: #ff6b38;
        clip: true;
        for mark in root.marks: Rectangle {
            x: mark.left * parent.width;
            y: mark.top * parent.height;
            width: (mark.right - mark.left) * parent.width;
            height: (mark.bottom - mark.top) * parent.height;
            border-width: root.mark-stroke;
            border-color: #ff3b30;
        }
        mark-drag := TouchArea {
            enabled: root.marking && root.marks.length < 64;
            mouse-cursor: crosshair;
            property <length> mark-left: clamp(min(self.pressed-x, self.mouse-x), 0px, parent.width);
            property <length> mark-top: clamp(min(self.pressed-y, self.mouse-y), 0px, parent.height);
            property <length> mark-right: clamp(max(self.pressed-x, self.mouse-x), 0px, parent.width);
            property <length> mark-bottom: clamp(max(self.pressed-y, self.mouse-y), 0px, parent.height);
            pointer-event(event) => {
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left
                    && self.mark-right - self.mark-left >= 2px && self.mark-bottom - self.mark-top >= 2px {
                    root.add-mark({
                        left: self.mark-left / self.width,
                        top: self.mark-top / self.height,
                        right: self.mark-right / self.width,
                        bottom: self.mark-bottom / self.height,
                    });
                }
            }
        }
        if mark-drag.pressed: Rectangle {
            x: mark-drag.mark-left;
            y: mark-drag.mark-top;
            width: mark-drag.mark-right - mark-drag.mark-left;
            height: mark-drag.mark-bottom - mark-drag.mark-top;
            border-width: root.mark-stroke;
            border-color: #ff3b30;
        }
    }

    if root.selected: Rectangle {
        x: clamp(root.left, root.gap, root.width - self.width - root.gap);
        y: root.chip-y;
        width: dimensions.preferred-width + 14px;
        height: root.chip-height;
        border-radius: 5px;
        background: #202124;
        dimensions := Text {
            text: "" + (ceil(root.right / root.width * root.source-width) - floor(root.left / root.width * root.source-width))
                + " × " + (ceil(root.bottom / root.height * root.source-height) - floor(root.top / root.height * root.source-height));
            font-size: 12px;
            color: #ffffff;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if !root.selected: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 16px;
        width: 260px;
        height: root.toolbar-height;
        border-radius: 8px;
        background: #202124;
        TouchArea { }
        HorizontalLayout {
            padding: 8px;
            spacing: 6px;
            Text {
                text: "Drag to select an area";
                color: #ffffff;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: center;
                horizontal-stretch: 1;
            }
            Button { text: "Cancel"; width: 66px; clicked => { root.cancel(); } }
        }
    }

    if root.ready: Rectangle {
        x: clamp(root.right - self.width, root.gap, root.width - self.width - root.gap);
        y: root.toolbar-y;
        width: root.toolbar-width;
        height: root.toolbar-height;
        border-radius: 8px;
        background: #202124;
        TouchArea { }
        HorizontalLayout {
            padding: 8px;
            spacing: 6px;
            for command in root.commands: Button {
                text: command.label;
                width: root.button-width;
                clicked => { root.commit(command.action); }
            }
            Button {
                text: root.marking ? "Select" : "Rectangle";
                width: root.button-width;
                clicked => { root.marking = !root.marking; keys.focus(); }
            }
            Button {
                text: "Undo";
                width: root.button-width;
                enabled: root.marks.length > 0;
                clicked => { root.undo-mark(); keys.focus(); }
            }
            Button { text: "Cancel"; width: root.button-width; clicked => { root.cancel(); } }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if root.ready && event.text == Key.Return {
                root.commit(CaptureAction.copy);
                return accept;
            }
            if root.ready && root.marks.length > 0 && (event.modifiers.control || event.modifiers.meta) && event.text == "z" {
                root.undo-mark();
                return accept;
            }
            reject
        }
    }
}
