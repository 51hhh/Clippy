import { Button, CheckBox, Slider, VerticalBox } from "std-widgets.slint";
import { ClippyTheme } from "theme.slint";

export component PinnedWindow inherits Window {
    in property <image> picture;
    in property <string> body;
    in property <bool> has-image;
    in-out property <float> zoom: 1;
    in-out property <float> opacity-value: 1;
    in-out property <bool> locked;
    in-out property <bool> above;
    in property <string> status;
    callback update-pin();
    callback resize-pin(float);
    callback close-pin();
    callback edit-pin();
    callback copy-pin();
    callback save-pin();

    title: "Clippy Pin";
    preferred-width: 500px;
    preferred-height: 440px;
    min-width: 330px;
    min-height: 200px;
    background: ClippyTheme.background;
    init => { ClippyTheme.sync-native-palette(); }

    VerticalBox {
        padding: 10px;
        spacing: 6px;
        Rectangle {
            vertical-stretch: 1;
            background: ClippyTheme.hover;
            if root.has-image: Image {
                source: root.picture;
                width: parent.width;
                height: parent.height;
                opacity: root.opacity-value;
                image-fit: contain;
            }
            if !root.has-image: Text {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                opacity: root.opacity-value;
                text: root.body;
                color: ClippyTheme.foreground;
                wrap: word-wrap;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: "Opacity"; color: ClippyTheme.foreground; vertical-alignment: center; }
            Slider {
                minimum: 0.15; maximum: 1; value <=> root.opacity-value;
                released => { root.update-pin(); }
            }
            Button { text: "−"; enabled: root.zoom > 0.25 && !root.locked; clicked => { root.resize-pin(max(0.25, root.zoom / 1.25)); } }
            Button { text: "+"; enabled: root.zoom < 4 && !root.locked; clicked => { root.resize-pin(min(4, root.zoom * 1.25)); } }
            CheckBox { text: "Top"; checked <=> root.above; toggled => { root.update-pin(); } }
            CheckBox { text: "Lock size"; checked <=> root.locked; toggled => { root.update-pin(); } }
        }
        HorizontalLayout {
            spacing: 4px;
            Button { text: "Edit"; enabled: root.has-image; clicked => { root.edit-pin(); } }
            Button { text: "Copy"; clicked => { root.copy-pin(); } }
            Button { text: "Save PNG"; enabled: root.has-image; clicked => { root.save-pin(); } }
            Button { text: "Hide"; clicked => { root.close-pin(); } }
        }
        if root.status != "": Text { text: root.status; color: ClippyTheme.muted; wrap: word-wrap; }
    }
}
