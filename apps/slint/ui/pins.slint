import { Slider } from "std-widgets.slint";
import { ClippyTheme, SurfaceButton } from "theme.slint";

export component PinnedWindow inherits Window {
    in property <image> picture;
    in property <string> body;
    in property <bool> has-image;
    in-out property <float> zoom: 1;
    in-out property <float> opacity-value: 1;
    in-out property <bool> locked;
    in-out property <bool> above;
    in property <string> status;
    callback update-pin();
    callback resize-pin(float);
    callback close-pin();
    callback edit-pin();
    callback copy-pin();
    callback save-pin();

    private property <bool> opacity-open;

    title: "Clippy Pin";
    no-frame: true;
    resize-border-width: ClippyTheme.window-resize-border;
    preferred-width: 500px;
    preferred-height: 440px;
    min-width: 330px;
    min-height: 220px;
    background: ClippyTheme.background;
    init => { ClippyTheme.sync-native-palette(); }

    public pure function drag-contains(x: length, y: length) -> bool {
        return x >= root.resize-border-width && x < root.width - 108px
            && y >= root.resize-border-width && y < root.height - root.resize-border-width
            && (!root.opacity-open || x < opacity-panel.x || y < opacity-panel.y
                || y >= opacity-panel.y + opacity-panel.height);
    }

    HorizontalLayout {
        padding: 7px;
        spacing: 6px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                clip: true;
                background: ClippyTheme.hover;
                if root.has-image: Image {
                    source: root.picture;
                    width: parent.width;
                    height: parent.height;
                    opacity: root.opacity-value;
                    image-fit: contain;
                }
                if !root.has-image: Text {
                    x: 9px;
                    y: 9px;
                    width: parent.width - 18px;
                    height: parent.height - 18px;
                    opacity: root.opacity-value;
                    text: root.body;
                    color: ClippyTheme.foreground;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
            if root.status != "": Text {
                text: root.status; color: ClippyTheme.muted; font-size: 12px; overflow: elide;
            }
        }
        Rectangle {
            width: 94px;
            background: ClippyTheme.elevated;
            border-radius: 8px;
            border-width: 1px;
            border-color: ClippyTheme.border;
            VerticalLayout {
                padding: 3px;
                spacing: 2px;
                HorizontalLayout {
                    height: 23px;
                    SurfaceButton { label: "Zoom out"; caption: "−"; enabled: root.zoom > 0.25 && !root.locked; clicked => { root.resize-pin(max(0.25, root.zoom / 1.25)); } }
                    Text {
                        text: "" + round(100 * root.zoom) + "%"; color: ClippyTheme.muted; font-size: 12px;
                        horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1;
                    }
                    SurfaceButton { label: "Zoom in"; caption: "+"; enabled: root.zoom < 4 && !root.locked; clicked => { root.resize-pin(min(4, root.zoom * 1.25)); } }
                }
                SurfaceButton {
                    label: "Opacity"; height: 23px; selected: root.opacity-open;
                    clicked => { root.opacity-open = !root.opacity-open; }
                }
                SurfaceButton {
                    label: root.above ? "Unpin top" : "Keep on top"; height: 23px; selected: root.above;
                    clicked => { root.above = !root.above; root.update-pin(); }
                }
                SurfaceButton {
                    label: root.locked ? "Unlock size" : "Lock size"; height: 23px; selected: root.locked;
                    clicked => { root.locked = !root.locked; root.update-pin(); }
                }
                if root.has-image: SurfaceButton { label: "Edit"; height: 23px; clicked => { root.edit-pin(); } }
                SurfaceButton { label: "Copy"; height: 23px; clicked => { root.copy-pin(); } }
                if root.has-image: SurfaceButton { label: "Save PNG"; height: 23px; clicked => { root.save-pin(); } }
                Rectangle { vertical-stretch: 1; }
                SurfaceButton { label: "Hide"; height: 23px; danger: true; clicked => { root.close-pin(); } }
            }
        }
    }
    opacity-panel := Rectangle {
        visible: root.opacity-open;
        x: root.width - 272px;
        y: 32px;
        width: 163px;
        height: 33px;
        border-radius: 7px;
        border-width: 1px;
        border-color: ClippyTheme.border;
        background: ClippyTheme.elevated;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Slider {
                accessible-label: "Pin opacity";
                minimum: 0.15; maximum: 1; value <=> root.opacity-value;
                released => { root.update-pin(); }
            }
            Text {
                text: "" + round(100 * root.opacity-value) + "%"; color: ClippyTheme.muted;
                font-size: 11px; vertical-alignment: center;
            }
        }
    }
}
